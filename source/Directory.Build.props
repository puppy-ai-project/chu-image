<Project>
  <PropertyGroup>
    <!-- Central app version: change ONLY here to update all platform projects -->
    <IgVersion>1.0.1</IgVersion>
    <IgReleaseType></IgReleaseType>
    <IgUpdateChannel>beta</IgUpdateChannel>

    <!-- App bundle version. Leave empty to derive from IgVersion -->
    <IgBundleShortVersion></IgBundleShortVersion>
    <IgBundleBuild></IgBundleBuild>
  </PropertyGroup>
</Project>
