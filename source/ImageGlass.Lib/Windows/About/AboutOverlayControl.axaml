<UserControl
    x:Class="ImageGlass.Common.Windows.AboutOverlayControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:types="using:ImageGlass.Common.Types"
    xmlns:ui="using:ImageGlass.UI"
    xmlns:windows="using:ImageGlass.Common.Windows"
    mc:Ignorable="d"
    d:DesignHeight="640"
    d:DesignWidth="920"
    x:Name="Root">

    <UserControl.Resources>
        <!--  弹窗光学高光描边 (与设置/图片信息弹窗统一)  -->
        <LinearGradientBrush x:Key="AboutGlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource IgDarkColor36FFFFFF}" Offset="0.0" />
            <GradientStop Color="{DynamicResource IgDarkColor16FFFFFF}" Offset="0.45" />
            <GradientStop Color="{DynamicResource IgDarkColor0BFFFFFF}" Offset="1.0" />
        </LinearGradientBrush>

        <!--  设计蓝主动作渐变  -->
        <LinearGradientBrush x:Key="AboutAccentBtnGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource IgDarkColor356BBF}" Offset="0.0" />
            <GradientStop Color="{DynamicResource IgDarkColor2B59A1}" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AboutAccentBtnHoverGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource IgDarkColor407AD2}" Offset="0.0" />
            <GradientStop Color="{DynamicResource IgDarkColor3368B8}" Offset="1.0" />
        </LinearGradientBrush>

        <!--  Hero 柔和双色流光衬底  -->
        <LinearGradientBrush x:Key="AboutHeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource IgDarkColor1B1D22}" Offset="0.0" />
            <GradientStop Color="{DynamicResource IgDarkColor242730}" Offset="0.55" />
            <GradientStop Color="{DynamicResource IgDarkColor1E3B82F6}" Offset="1.0" />
        </LinearGradientBrush>

        <!--  隔离 Fluent 默认按钮浅色干扰  -->
        <SolidColorBrush x:Key="PhButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="PhButtonBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="PhButtonBorderBrush" Color="Transparent" />

        <ControlTemplate x:Key="AboutCleanButtonTemplate" TargetType="Button">
            <Border
                x:Name="PART_AboutBtnBorder"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
                <ContentPresenter
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    Foreground="{TemplateBinding Foreground}" />
            </Border>
        </ControlTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  微关闭/辅助图标钮  -->
        <Style Selector="Button.about-icon-btn">
            <Setter Property="Template" Value="{StaticResource AboutCleanButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.about-icon-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush14FFFFFF}" />
        </Style>
        <Style Selector="Button.about-icon-btn:pressed">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush22FFFFFF}" />
        </Style>

        <!--  分段 Tab 按钮  -->
        <Style Selector="Button.about-tab-pill">
            <Setter Property="Template" Value="{StaticResource AboutCleanButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrush8E95A2}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.about-tab-pill:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush0CFFFFFF}" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushE5E7EB}" />
        </Style>
        <Style Selector="Button.about-tab-pill.active">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush263B82F6}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush4060A5FA}" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrush93C5FD}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  快捷资源链接卡按钮  -->
        <Style Selector="Button.about-link-card">
            <Setter Property="Template" Value="{StaticResource AboutCleanButtonTemplate}" />
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush181A20}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush12FFFFFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushE5E7EB}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.about-link-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush242730}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush3860A5FA}" />
        </Style>
        <Style Selector="Button.about-link-card:pressed">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush1D1F24}" />
        </Style>

        <!--  版本徽章 / Edition 胶囊按钮  -->
        <Style Selector="Button.about-edition-pill">
            <Setter Property="Template" Value="{StaticResource AboutCleanButtonTemplate}" />
            <Setter Property="Background" Value="{DynamicResource IgIconBlueSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush3860A5FA}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource IgIconBlueBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.about-edition-pill:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush263B82F6}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush5C60A5FA}" />
        </Style>
        <Style Selector="Button.about-edition-pill.pro">
            <Setter Property="Background" Value="{DynamicResource IgIconAmberSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgIconAmberBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource IgIconAmberBrush}" />
        </Style>

        <!--  底部次要胶囊按钮  -->
        <Style Selector="Button.about-secondary-btn">
            <Setter Property="Template" Value="{StaticResource AboutCleanButtonTemplate}" />
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush282B33}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush16FFFFFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushD1D5DB}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.about-secondary-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush323640}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush24FFFFFF}" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushF3F4F6}" />
        </Style>
        <Style Selector="Button.about-secondary-btn:pressed">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush22252C}" />
        </Style>

        <!--  底部主蓝色关闭按钮  -->
        <Style Selector="Button.about-primary-btn">
            <Setter Property="Template" Value="{StaticResource AboutCleanButtonTemplate}" />
            <Setter Property="Background" Value="{StaticResource AboutAccentBtnGradient}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush26FFFFFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushF9FAFB}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.about-primary-btn:pointerover">
            <Setter Property="Background" Value="{StaticResource AboutAccentBtnHoverGradient}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush38FFFFFF}" />
        </Style>
        <Style Selector="Button.about-primary-btn:pressed">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush224987}" />
        </Style>

        <!--  开源致谢行卡悬浮质感  -->
        <Style Selector="Border.about-credit-card">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush181A20}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush10FFFFFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style Selector="Border.about-credit-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush242730}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush24FFFFFF}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!--  全屏柔暗压光遮罩 (点击卡片外区域关闭)  -->
        <Border Background="{DynamicResource IgDarkBrush7A000000}" PointerPressed="Backdrop_PointerPressed" />

        <!--  随当前主题明暗自动切换的内嵌作用域  -->
        <ThemeVariantScope>
            <Border
                Margin="22,16"
                MinWidth="440"
                MaxWidth="590"
                MinHeight="320"
                MaxHeight="580"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                BorderBrush="{StaticResource AboutGlassBorderBrush}"
                BorderThickness="1"
                BoxShadow="0 24 64 0 #B3000000"
                ClipToBounds="True"
                CornerRadius="14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource IgDarkColor292C33}" Offset="0.0" />
                        <GradientStop Color="{DynamicResource IgDarkColor23252B}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid RowDefinitions="Auto,Auto,*,Auto">

                    <!--  ======================================================  -->
                    <!--  1. HERO BRAND BANNER (全新图标 + 标题 + 版本徽章 + 粒子星芒)  -->
                    <!--  ======================================================  -->
                    <Border
                        x:Name="PART_Hero"
                        Grid.Row="0"
                        Padding="22,18,16,16"
                        Background="{StaticResource AboutHeroGradient}"
                        BorderBrush="{DynamicResource IgDarkBrush10FFFFFF}"
                        BorderThickness="0,0,0,1"
                        Cursor="Hand"
                        PointerPressed="Hero_PointerPressed">
                        <Panel>
                            <!--  星空微光粒子动画层 (置于标识下方)  -->
                            <ui:PhStarsOverlay x:Name="PART_HeroStars" IsHitTestVisible="False" />

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <!--  新版 Prism Lens 应用 Logo 展台  -->
                                <Border
                                    Grid.Column="0"
                                    Width="78"
                                    Height="78"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource IgDarkBrush14FFFFFF}"
                                    BorderBrush="{DynamicResource IgDarkBrush22FFFFFF}"
                                    BorderThickness="1"
                                    BoxShadow="0 8 24 0 #40000000"
                                    CornerRadius="20">
                                    <ui:PhLogo
                                        x:Name="PART_Logo"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        LogoSize="64" />
                                </Border>

                                <!--  应用名称、版本胶囊、Slogan 与版权  -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="20.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource IgDarkBrushF3F4F6}"
                                            Text="ImageGlass 10" />

                                        <Button
                                            x:Name="PART_BtnEdition"
                                            Classes="link about-edition-pill"
                                            VerticalAlignment="Center"
                                            Click="Edition_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Path
                                                    x:Name="PART_EditionStarIcon"
                                                    Width="10"
                                                    Height="10"
                                                    VerticalAlignment="Center"
                                                    Data="{StaticResource IconProStar}"
                                                    Fill="{DynamicResource IgIconAmberBrush}"
                                                    IsVisible="False"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    x:Name="PART_TxtEdition"
                                                    VerticalAlignment="Center"
                                                    Text="Classic" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <TextBlock
                                        x:Name="PART_LblSlogan"
                                        FontSize="12.5"
                                        Foreground="{DynamicResource IgDarkBrushD1D5DB}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        x:Name="PART_LblCopyright"
                                        Margin="0,1,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource IgDarkBrush8B92A0}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <!--  右上角关闭按钮  -->
                                <Button
                                    x:Name="PART_BtnClose"
                                    Classes="link about-icon-btn"
                                    Grid.Column="2"
                                    VerticalAlignment="Top"
                                    Click="Close_Click">
                                    <Path
                                        Width="9.5"
                                        Height="9.5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource IconClose}"
                                        Fill="{DynamicResource IgDarkBrush8E95A2}"
                                        Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </Panel>
                    </Border>

                    <!--  ======================================================  -->
                    <!--  2. SEGMENTED TABS BAR (应用与环境 | 开源致谢)              -->
                    <!--  ======================================================  -->
                    <Border
                        Grid.Row="1"
                        Padding="22,10"
                        BorderBrush="{DynamicResource IgDarkBrush0AFFFFFF}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border
                                Grid.Column="0"
                                Padding="3"
                                Background="{DynamicResource IgDarkBrush15171C}"
                                BorderBrush="{DynamicResource IgDarkBrush14FFFFFF}"
                                BorderThickness="1"
                                CornerRadius="9">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Button
                                        x:Name="PART_TabOverview"
                                        Classes="link about-tab-pill active"
                                        Click="Tab_Click"
                                        Tag="overview">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path
                                                Width="12"
                                                Height="12"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource IconInfo}"
                                                Fill="{DynamicResource IgIconCyanBrush}"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                x:Name="PART_TxtTabOverview"
                                                VerticalAlignment="Center"
                                                Text="版本与链接" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="PART_TabCredits"
                                        Classes="link about-tab-pill"
                                        Click="Tab_Click"
                                        Tag="credits">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path
                                                Width="12"
                                                Height="12"
                                                VerticalAlignment="Center"
                                                Data="M12 21.35 10.55 20.03C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35Z"
                                                Fill="{DynamicResource IgIconPurpleBrush}"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                x:Name="PART_TxtTabCredits"
                                                VerticalAlignment="Center"
                                                Text="开源致谢" />
                                            <Border
                                                Padding="5,0.5"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource IgDarkBrush14FFFFFF}"
                                                CornerRadius="6">
                                                <TextBlock
                                                    x:Name="PART_TxtCreditsCount"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource IgDarkBrush9CA3AF}"
                                                    Text="12" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!--  右侧一键复制版本快捷按钮  -->
                            <Button
                                x:Name="PART_BtnCopyVersion"
                                Classes="link about-secondary-btn"
                                Grid.Column="2"
                                Height="28"
                                Padding="10,0"
                                Click="CopyVersion_Click">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Path
                                        x:Name="PART_CopyIcon"
                                        Width="11.5"
                                        Height="11.5"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource IconCopy}"
                                        Fill="{DynamicResource IgIconBlueBrush}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        x:Name="PART_TxtCopyVersion"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Text="复制版本" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!--  ======================================================  -->
                    <!--  3. CONTENT BODY (Overview vs Credits)                   -->
                    <!--  ======================================================  -->
                    <Panel Grid.Row="2">

                        <!--  PAGE 1: 版本信息卡片 + 快捷入口链接  -->
                        <ScrollViewer
                            x:Name="PART_OverviewPanel"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22,16,22,18" Spacing="14">

                                <!--  3.1 三列环境信息卡片  -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                    <!--  App 版本卡片  -->
                                    <Border
                                        Grid.Column="0"
                                        Padding="12,10"
                                        Background="{DynamicResource IgDarkBrush181A20}"
                                        BorderBrush="{DynamicResource IgDarkBrush12FFFFFF}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Border
                                                    Width="22"
                                                    Height="22"
                                                    Background="{DynamicResource IgIconBlueSoftBrush}"
                                                    CornerRadius="6">
                                                    <Path
                                                        Width="11.5"
                                                        Height="11.5"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Data="{StaticResource IconVerify}"
                                                        Fill="{DynamicResource IgIconBlueBrush}"
                                                        Stretch="Uniform" />
                                                </Border>
                                                <TextBlock
                                                    x:Name="PART_LblCardVersionTitle"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource IgDarkBrush8B92A0}"
                                                    Text="应用版本" />
                                            </StackPanel>
                                            <SelectableTextBlock
                                                x:Name="PART_ValAppVersion"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource IgDarkBrushF3F4F6}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!--  Magick.NET 图像引擎卡片  -->
                                    <Border
                                        Grid.Column="1"
                                        Padding="12,10"
                                        Background="{DynamicResource IgDarkBrush181A20}"
                                        BorderBrush="{DynamicResource IgDarkBrush12FFFFFF}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Border
                                                    Width="22"
                                                    Height="22"
                                                    Background="{DynamicResource IgIconPurpleSoftBrush}"
                                                    CornerRadius="6">
                                                    <Path
                                                        Width="11.5"
                                                        Height="11.5"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Data="{StaticResource IconToolImageResizer}"
                                                        Fill="{DynamicResource IgIconPurpleBrush}"
                                                        Stretch="Uniform" />
                                                </Border>
                                                <TextBlock
                                                    x:Name="PART_LblCardMagickTitle"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource IgDarkBrush8B92A0}"
                                                    Text="图像引擎" />
                                            </StackPanel>
                                            <SelectableTextBlock
                                                x:Name="PART_ValMagickVersion"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource IgDarkBrushF3F4F6}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!--  .NET 运行环境卡片  -->
                                    <Border
                                        Grid.Column="2"
                                        Padding="12,10"
                                        Background="{DynamicResource IgDarkBrush181A20}"
                                        BorderBrush="{DynamicResource IgDarkBrush12FFFFFF}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Border
                                                    Width="22"
                                                    Height="22"
                                                    Background="{DynamicResource IgIconEmeraldSoftBrush}"
                                                    CornerRadius="6">
                                                    <Path
                                                        Width="11.5"
                                                        Height="11.5"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Data="{StaticResource IconIntegrated}"
                                                        Fill="{DynamicResource IgIconEmeraldBrush}"
                                                        Stretch="Uniform" />
                                                </Border>
                                                <TextBlock
                                                    x:Name="PART_LblCardRuntimeTitle"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource IgDarkBrush8B92A0}"
                                                    Text="运行框架" />
                                            </StackPanel>
                                            <SelectableTextBlock
                                                x:Name="PART_ValRuntimeVersion"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource IgDarkBrushF3F4F6}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!--  3.2 完整运行环境摘要信息条  -->
                                <Border
                                    Padding="12,8"
                                    Background="{DynamicResource IgDarkBrush15171C}"
                                    BorderBrush="{DynamicResource IgDarkBrush0DFFFFFF}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <SelectableTextBlock
                                        x:Name="PART_LblFullVersionLine"
                                        FontFamily="{x:Static types:Const.FONT_CODE}"
                                        FontSize="10.8"
                                        Foreground="{DynamicResource IgDarkBrush8B92A0}"
                                        TextWrapping="Wrap" />
                                </Border>

                                <!--  3.3 快捷资源链接卡片组 (2x2 网格)  -->
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        x:Name="PART_LblLinksHeading"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource IgDarkBrush8B92A0}"
                                        Text="相关链接与协议" />

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                        <!--  官方网站  -->
                                        <Button
                                            x:Name="PART_BtnWebsite"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Classes="link about-link-card"
                                            Click="Link_Click"
                                            Tag="https://image.withqq.com">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Grid.Column="0" Width="28" Height="28" Background="{DynamicResource IgIconBlueSoftBrush}" CornerRadius="7">
                                                    <Path Width="13.5" Height="13.5" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource IgIconBlueBrush}" Stretch="Uniform" Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.92 6h-3.17a14.6 14.6 0 0 0-1.36-3.56A8.03 8.03 0 0 1 18.92 8ZM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96ZM4.26 14a8.26 8.26 0 0 1 0-4h3.38a16.5 16.5 0 0 0 0 4H4.26Zm.82 2h3.17c.34 1.24.8 2.43 1.36 3.56A8.03 8.03 0 0 1 5.08 16Zm3.17-8H5.08a8.03 8.03 0 0 1 4.53-3.56A14.6 14.6 0 0 0 8.25 8ZM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96ZM14.34 14H9.66a14.7 14.7 0 0 1 0-4h4.68a14.7 14.7 0 0 1 0 4Zm.05 5.56c.56-1.13 1.02-2.32 1.36-3.56h3.17a8.03 8.03 0 0 1-4.53 3.56ZM16.36 14a16.5 16.5 0 0 0 0-4h3.38a8.26 8.26 0 0 1 0 4h-3.38Z" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock x:Name="PART_TxtWebsiteTitle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource IgDarkBrushF3F4F6}" Text="官方网站" />
                                                    <TextBlock FontSize="10.5" Foreground="{DynamicResource IgDarkBrush8B92A0}" Text="image.withqq.com" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Path Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource IgDarkBrush6F7785}" Stretch="Uniform" Data="M6.4 18 5 16.6 14.6 7H6V5h12v12h-2V8.4L6.4 18Z" />
                                            </Grid>
                                        </Button>

                                        <!--  GitHub  -->
                                        <Button
                                            x:Name="PART_BtnGitHub"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Classes="link about-link-card"
                                            Click="Link_Click"
                                            Tag="https://image.withqq.com">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Grid.Column="0" Width="28" Height="28" Background="{DynamicResource IgIconPurpleSoftBrush}" CornerRadius="7">
                                                    <Path Width="13.5" Height="13.5" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource IgIconPurpleBrush}" Stretch="Uniform" Data="M12 2C6.48 2 2 6.59 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.08 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.05A9.38 9.38 0 0 1 12 6.84c.85 0 1.71.12 2.51.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.46.1 2.72.64.72 1.03 1.64 1.03 2.76 0 3.95-2.34 4.82-4.57 5.07.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.25C22 6.59 17.52 2 12 2Z" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock x:Name="PART_TxtGitHubTitle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource IgDarkBrushF3F4F6}" Text="GitHub" />
                                                    <TextBlock x:Name="PART_TxtGitHubSub" FontSize="10.5" Foreground="{DynamicResource IgDarkBrush8B92A0}" Text="开源项目主页与文档" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Path Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource IgDarkBrush6F7785}" Stretch="Uniform" Data="M6.4 18 5 16.6 14.6 7H6V5h12v12h-2V8.4L6.4 18Z" />
                                            </Grid>
                                        </Button>

                                        <!--  许可协议  -->
                                        <Button
                                            x:Name="PART_BtnEula"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Classes="link about-link-card"
                                            Click="Link_Click"
                                            Tag="https://image.withqq.com">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Grid.Column="0" Width="28" Height="28" Background="{DynamicResource IgIconEmeraldSoftBrush}" CornerRadius="7">
                                                    <Path Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource IgIconEmeraldBrush}" Stretch="Uniform" Data="M6 2a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6H6Zm7 1.5L18.5 9H13V3.5ZM8.5 13h7a.75.75 0 0 1 0 1.5h-7a.75.75 0 0 1 0-1.5Zm0 3.5h5a.75.75 0 0 1 0 1.5h-5a.75.75 0 0 1 0-1.5Z" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock x:Name="PART_TxtEulaTitle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource IgDarkBrushF3F4F6}" Text="许可协议" />
                                                    <TextBlock FontSize="10.5" Foreground="{DynamicResource IgDarkBrush8B92A0}" Text="GNU GPL v3" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Path Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource IgDarkBrush6F7785}" Stretch="Uniform" Data="M6.4 18 5 16.6 14.6 7H6V5h12v12h-2V8.4L6.4 18Z" />
                                            </Grid>
                                        </Button>

                                        <!--  隐私政策  -->
                                        <Button
                                            x:Name="PART_BtnPrivacy"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Classes="link about-link-card"
                                            Click="Link_Click"
                                            Tag="https://image.withqq.com">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Grid.Column="0" Width="28" Height="28" Background="{DynamicResource IgIconCyanSoftBrush}" CornerRadius="7">
                                                    <Path Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource IgIconCyanBrush}" Stretch="Uniform" Data="M12 2 4 5.5v5.6c0 5.05 3.41 9.77 8 10.9 4.59-1.13 8-5.85 8-10.9V5.5L12 2Zm0 4.5a2.5 2.5 0 0 1 2.5 2.5v1h.5a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h.5V9A2.5 2.5 0 0 1 12 6.5Zm-1 3.5h2V9a1 1 0 0 0-2 0v1Z" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock x:Name="PART_TxtPrivacyTitle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource IgDarkBrushF3F4F6}" Text="隐私声明" />
                                                    <TextBlock x:Name="PART_TxtPrivacySub" FontSize="10.5" Foreground="{DynamicResource IgDarkBrush8B92A0}" Text="本地离线安全浏览" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Path Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource IgDarkBrush6F7785}" Stretch="Uniform" Data="M6.4 18 5 16.6 14.6 7H6V5h12v12h-2V8.4L6.4 18Z" />
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <!--  PAGE 2: 开源致谢与组件清单  -->
                        <ScrollViewer
                            x:Name="PART_CreditsPanel"
                            HorizontalScrollBarVisibility="Disabled"
                            IsVisible="False"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22,14,22,18" Spacing="8">
                                <ItemsControl x:Name="PART_CreditsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="windows:AboutCreditItem">
                                            <Border Classes="about-credit-card">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="12.5"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource IgDarkBrushF3F4F6}"
                                                                Text="{CompiledBinding Name}" />
                                                            <Border
                                                                Padding="6,1"
                                                                VerticalAlignment="Center"
                                                                Background="{CompiledBinding BadgeBackground}"
                                                                CornerRadius="4"
                                                                IsVisible="{CompiledBinding HasLicense}">
                                                                <TextBlock
                                                                    FontSize="9.5"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{CompiledBinding BadgeForeground}"
                                                                    Text="{CompiledBinding License}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{DynamicResource IgDarkBrush8B92A0}"
                                                            Text="{CompiledBinding Copyright}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        MaxWidth="236"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{x:Static types:Const.FONT_CODE}"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource IgDarkBrush6F7785}"
                                                        IsVisible="{CompiledBinding HasUrl}"
                                                        Text="{CompiledBinding Url}"
                                                        TextAlignment="Right"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip.Tip="{CompiledBinding Url}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                    </Panel>

                    <!--  ======================================================  -->
                    <!--  4. UNIFIED FOOTER (赞助 / 检查更新 / 关闭)              -->
                    <!--  ======================================================  -->
                    <Border
                        Grid.Row="3"
                        Padding="22,12"
                        Background="{DynamicResource IgDarkBrush1C1E23}"
                        BorderBrush="{DynamicResource IgDarkBrush10FFFFFF}"
                        BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button
                                    x:Name="PART_BtnDonate"
                                    Classes="link about-secondary-btn"
                                    Click="Link_Click"
                                    Tag="https://image.withqq.com">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path
                                            Width="12"
                                            Height="12"
                                            VerticalAlignment="Center"
                                            Data="M12 21.35 10.55 20.03C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35Z"
                                            Fill="{DynamicResource IgIconRoseBrush}"
                                            Stretch="Uniform" />
                                        <TextBlock x:Name="PART_TxtDonate" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    x:Name="PART_BtnCheckForUpdate"
                                    Classes="link about-secondary-btn"
                                    Click="CheckForUpdate_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path
                                            Width="12"
                                            Height="12"
                                            VerticalAlignment="Center"
                                            Data="{StaticResource IconReset}"
                                            Fill="{DynamicResource IgIconCyanBrush}"
                                            Stretch="Uniform" />
                                        <TextBlock x:Name="PART_TxtCheckUpdate" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Button
                                x:Name="PART_BtnDone"
                                Classes="link about-primary-btn"
                                Grid.Column="1"
                                Click="Close_Click" />
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </ThemeVariantScope>
    </Grid>
</UserControl>
