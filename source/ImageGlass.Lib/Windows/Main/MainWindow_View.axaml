<ui:PhControl
    x:Class="ImageGlass.Common.Windows.MainWindowView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cm="using:ImageGlass.Common"
    xmlns:tool="using:ImageGlass.Tools"
    xmlns:ui="using:ImageGlass.UI"
    xmlns:viewer="using:ImageGlass.UI.Viewer"
    xmlns:vm="using:ImageGlass.ViewModels"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="900"
    x:DataType="vm:MainWindowViewModel"
    x:Name="Root">

    <ui:PhControl.Resources>
        <!--  顶部工作台渐变：轻盈温润石板灰  -->
        <LinearGradientBrush x:Key="WindowBarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2C2E34" Offset="0.0" />
            <GradientStop Color="#23252A" Offset="1.0" />
        </LinearGradientBrush>
        <!--  底部控制栏渐变  -->
        <LinearGradientBrush x:Key="WindowBottomBarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#23252A" Offset="0.0" />
            <GradientStop Color="#1D1F24" Offset="1.0" />
        </LinearGradientBrush>
        <!--  弹窗光学顶高光玻璃描边 (顶部微光反射逐渐衰减)  -->
        <LinearGradientBrush x:Key="ModalGlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#36FFFFFF" Offset="0.0" />
            <GradientStop Color="#16FFFFFF" Offset="0.45" />
            <GradientStop Color="#0BFFFFFF" Offset="1.0" />
        </LinearGradientBrush>
        <!--  弹窗确认删除柔雅低饱和珊瑚红渐变 (与暗灰主调和谐融合)  -->
        <LinearGradientBrush x:Key="DangerBtnGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#B83E3E" Offset="0.0" />
            <GradientStop Color="#9E3232" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBtnHoverGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C94B4B" Offset="0.0" />
            <GradientStop Color="#AE3B3B" Offset="1.0" />
        </LinearGradientBrush>
        <!--  弹窗确认/完成温和沉稳蓝渐变  -->
        <LinearGradientBrush x:Key="ModalAccentBtnGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#356BBF" Offset="0.0" />
            <GradientStop Color="#2B59A1" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ModalAccentBtnHoverGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#407AD2" Offset="0.0" />
            <GradientStop Color="#3368B8" Offset="1.0" />
        </LinearGradientBrush>
        <!--  弹窗专用干净按钮模板：彻底隔离全局 ButtonStyle.axaml 的浅色主题覆盖  -->
        <ControlTemplate x:Key="ModalCleanButtonTemplate" TargetType="Button">
            <Border
                x:Name="PART_ModalBtnBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
                <ContentPresenter
                    x:Name="PART_ModalContentPresenter"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    Foreground="{TemplateBinding Foreground}"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
        </ControlTemplate>
        <!--  弹窗专用干净复选框模板：彻底隔离 FluentTheme Light/Dark 对文字和底色在 hover/pressed 时发黑的干扰  -->
        <ControlTemplate x:Key="ModalCleanCheckBoxTemplate" TargetType="CheckBox">
            <Grid Background="Transparent" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <Border
                    x:Name="PART_ModalCheckBox"
                    Grid.Column="0"
                    Width="15"
                    Height="15"
                    CornerRadius="4"
                    BorderThickness="1.2"
                    Background="#181A1F"
                    BorderBrush="#4B505C"
                    VerticalAlignment="Center">
                    <Path
                        x:Name="PART_ModalCheckMark"
                        Width="9"
                        Height="9"
                        Data="M 1,4.5 L 3.5,7 L 8,1.5"
                        Stroke="#FFFFFF"
                        StrokeThickness="1.6"
                        StrokeLineCap="Round"
                        StrokeJoin="Round"
                        Stretch="Uniform"
                        Opacity="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <ContentPresenter
                    x:Name="PART_ModalCheckContent"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    Foreground="{TemplateBinding Foreground}"
                    VerticalAlignment="Center" />
            </Grid>
        </ControlTemplate>
    </ui:PhControl.Resources>

    <ui:PhControl.Styles>
        <Style Selector="ui|GalleryControl">
            <Setter Property="Background" Value="{DynamicResource IG_ThemeGalleryBackgroundBrush}" />
        </Style>
        <Style Selector="ui|GalleryControl.overlay">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!--  macOS Traffic Light Window Buttons (原生悬停淡入图标质感)  -->
        <Style Selector="Button.mac-win-btn">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.mac-win-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.88)" />
        </Style>
        <Style Selector="Button.mac-win-btn.close">
            <Setter Property="Background" Value="#FF5F56" />
            <Setter Property="BorderBrush" Value="#E0443E" />
        </Style>
        <Style Selector="Button.mac-win-btn.close:pointerover">
            <Setter Property="Background" Value="#FF736A" />
        </Style>
        <Style Selector="Button.mac-win-btn.minimize">
            <Setter Property="Background" Value="#FFBD2E" />
            <Setter Property="BorderBrush" Value="#DEA123" />
        </Style>
        <Style Selector="Button.mac-win-btn.minimize:pointerover">
            <Setter Property="Background" Value="#FFCC4D" />
        </Style>
        <Style Selector="Button.mac-win-btn.maximize">
            <Setter Property="Background" Value="#27C93F" />
            <Setter Property="BorderBrush" Value="#1AAB29" />
        </Style>
        <Style Selector="Button.mac-win-btn.maximize:pointerover">
            <Setter Property="Background" Value="#3BD852" />
        </Style>

        <!-- macOS Traffic Light Icons: 平时隐藏保持纯净圆点，悬停红绿灯组时同步淡入 -->
        <Style Selector="Button.mac-win-btn Path">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel#PART_MacButtons:pointerover Button.mac-win-btn Path">
            <Setter Property="Opacity" Value="0.82" />
        </Style>
        <Style Selector="Button.mac-win-btn:pointerover Path">
            <Setter Property="Opacity" Value="1.0" />
        </Style>

        <!--  Windows Caption Buttons  -->
        <Style Selector="Button.win-caption-btn">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.win-caption-btn:pointerover">
            <Setter Property="Background" Value="#18FFFFFF" />
        </Style>
        <Style Selector="Button.win-caption-btn:pressed">
            <Setter Property="Background" Value="#24FFFFFF" />
        </Style>
        <Style Selector="Button.win-caption-btn-close">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.win-caption-btn-close:pointerover">
            <Setter Property="Background" Value="#E81123" />
        </Style>
        <Style Selector="Button.win-caption-btn-close:pointerover Line">
            <Setter Property="Stroke" Value="White" />
        </Style>
        <Style Selector="Button.win-caption-btn-close:pressed">
            <Setter Property="Background" Value="#C42B1C" />
        </Style>
        <Style Selector="Button.win-caption-btn-close:pressed Line">
            <Setter Property="Stroke" Value="White" />
        </Style>
    </ui:PhControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="#1D1F24">
        <!--  Custom Title Bar (纤巧精致的 38px 顶栏)  -->
        <Border
            x:Name="PART_CustomTitleBarBorder"
            Grid.Row="0"
            Height="38"
            Background="{StaticResource WindowBarGradient}"
            BorderBrush="#12FFFFFF"
            BorderThickness="0,0,0,1">
            <Grid
                x:Name="PART_CustomTitleBar"
                ColumnDefinitions="Auto,*,Auto"
                PointerPressed="TitleBar_PointerPressed">

                <!--  Left Group: macOS Traffic Lights OR Windows App Icon + Title  -->
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <!-- macOS Traffic Lights (Close ✕, Minimize —, Maximize +) -->
                    <StackPanel
                        x:Name="PART_MacButtons"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Margin="14,0,10,0"
                        Background="Transparent">
                        <Button Classes="mac-win-btn close" Background="#FF5F56" Click="CloseWindow_Click" ToolTip.Tip="关闭">
                            <Border Width="12" Height="12" CornerRadius="6" Background="#FF5F56">
                            <Path
                                Width="6"
                                Height="6"
                                Data="M 1,1 L 5,5 M 5,1 L 1,5"
                                Stroke="#4C0000"
                                StrokeThickness="1.2"
                                StrokeLineCap="Round"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            </Border>
                        </Button>
                        <Button Classes="mac-win-btn minimize" Background="#FFBD2E" Click="MinimizeWindow_Click" ToolTip.Tip="最小化">
                            <Border Width="12" Height="12" CornerRadius="6" Background="#FFBD2E">
                            <Path
                                Width="6"
                                Height="6"
                                Data="M 0.5,3 L 5.5,3"
                                Stroke="#563D00"
                                StrokeThickness="1.2"
                                StrokeLineCap="Round"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            </Border>
                        </Button>
                        <Button Classes="mac-win-btn maximize" Background="#27C93F" Click="MaximizeWindow_Click" ToolTip.Tip="最大化">
                            <Border Width="12" Height="12" CornerRadius="6" Background="#27C93F">
                            <Path
                                Width="6"
                                Height="6"
                                Data="M 0,2.5 L 3.5,0 L 3.5,2.5 Z M 6,3.5 L 2.5,6 L 2.5,3.5 Z"
                                Fill="#004D1A"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            </Border>
                        </Button>
                    </StackPanel>

                    <!-- Windows App Icon -->
                    <Image
                        x:Name="PART_WinAppIcon"
                        Width="15"
                        Height="15"
                        Margin="12,0,8,0"
                        VerticalAlignment="Center"
                        Source="avares://ImageGlass.Lib/Assets/icon256.ico" />

                    <!-- Window Title / Current File Name -->
                    <Border Background="Transparent" VerticalAlignment="Stretch">
                    <TextBlock
                        x:Name="PART_CustomTitle"
                        VerticalAlignment="Center"
                        Margin="4,0,12,0"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="#E5E7EB"
                        Opacity="0.92"
                        TextTrimming="CharacterEllipsis"
                        MaxWidth="280"
                        IsHitTestVisible="False" />
                    </Border>
                </StackPanel>

                <!-- Column 1: Embedded Modern Toolbar (Expanded, full buttons visible) -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Right"
                              VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                <ui:ToolbarControl
                    x:Name="PART_Toolbar"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{x:Null}"
                    DataContext="{CompiledBinding ToolbarVM}"
                    IsContentVisible="{CompiledBinding ShowToolbar, Source={x:Static cm:Core.Config}}"
                    ItemsSource="{CompiledBinding ToolbarButtons, Source={x:Static cm:Core.Config}}"
                    Margin="0,0,10,0" />
                </ScrollViewer>

                <!-- Column 2: Windows Caption Buttons (Minimize, Maximize/Restore, Close) -->
                <StackPanel
                    x:Name="PART_WinButtons"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Stretch"
                    Background="Transparent">
                    <Button
                        x:Name="PART_WinBtnMinimize"
                        Classes="win-caption-btn"
                        Click="MinimizeWindow_Click"
                        ToolTip.Tip="最小化">
                        <Panel Width="10" Height="10">
                            <Line
                                StartPoint="0,5"
                                EndPoint="10,5"
                                Stroke="#E5E7EB"
                                StrokeThickness="1" />
                        </Panel>
                    </Button>
                    <Button
                        x:Name="PART_WinBtnMaximize"
                        Classes="win-caption-btn"
                        Click="MaximizeWindow_Click"
                        ToolTip.Tip="最大化">
                        <Panel Width="10" Height="10">
                            <Rectangle
                                x:Name="PART_PathMaximize"
                                Width="10"
                                Height="10"
                                Stroke="#E5E7EB"
                                StrokeThickness="1" />
                            <Path
                                x:Name="PART_PathRestore"
                                Width="10"
                                Height="10"
                                Data="M 2,0 H 10 V 8 H 8 M 0,2 H 8 V 10 H 0 Z"
                                IsVisible="False"
                                Stroke="#E5E7EB"
                                StrokeThickness="1" />
                        </Panel>
                    </Button>
                    <Button
                        x:Name="PART_WinBtnClose"
                        Classes="win-caption-btn-close"
                        Click="CloseWindow_Click"
                        ToolTip.Tip="关闭">
                        <Panel Width="10" Height="10">
                            <Line
                                StartPoint="0,0"
                                EndPoint="10,10"
                                Stroke="#E5E7EB"
                                StrokeThickness="1.1" />
                            <Line
                                StartPoint="10,0"
                                EndPoint="0,10"
                                Stroke="#E5E7EB"
                                StrokeThickness="1.1" />
                        </Panel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Main Content Area (Viewer & Gallery)  -->
        <Grid x:Name="PART_Layout" Grid.Row="1" RowDefinitions="Auto, *, Auto, Auto">
            <!--  Viewer  -->
            <Grid
                x:Name="PART_ViewerWrapper"
                Grid.Row="1"
                RowDefinitions="*, Auto">
                <Border Background="{StaticResource WindowBarGradient}">
                    <Border Background="Transparent">
                        <viewer:ViewerControl
                        x:Name="PART_Viewer"
                        Grid.Row="0"
                        CheckerboardMode="{CompiledBinding CheckerboardMode, Source={x:Static cm:Core.Config}}"
                        EnableDebug="{CompiledBinding EnableDebug, Source={x:Static cm:Core.Config}}"
                        EnableFreePan="{CompiledBinding EnableFreePan, Source={x:Static cm:Core.Config}, Converter={x:Static cm:ProGate.Bool}}"
                        EnableHdrRendering="{CompiledBinding EnableHdrToneMapping, Source={x:Static cm:Core.Config}}"
                        EnableNavButtons="False"
                        InterpolationScaleDown="{CompiledBinding ImageInterpolationScaleDown, Source={x:Static cm:Core.Config}}"
                        InterpolationScaleUp="{CompiledBinding ImageInterpolationScaleUp, Source={x:Static cm:Core.Config}}"
                        IsWindowFitMode="{CompiledBinding EnableWindowFit, Source={x:Static cm:Core.Config}}"
                        PanMargin="{CompiledBinding PanMargin, Source={x:Static cm:Core.Config}, Converter={x:Static cm:ProGate.DoubleOrZero}}"
                        PanSpeed="{CompiledBinding PanSpeed, Source={x:Static cm:Core.Config}}"
                        ScrollbarMode="{CompiledBinding ViewerScrollbarMode, Source={x:Static cm:Core.Config}}"
                        ZoomLevels="{CompiledBinding ZoomLevels, Source={x:Static cm:Core.Config}}"
                        ZoomMode="{CompiledBinding ZoomMode, Source={x:Static cm:Core.Config}}"
                        ZoomSpeed="{CompiledBinding ZoomSpeed, Source={x:Static cm:Core.Config}}">
                        <Panel>
                            <ui:ImageInfoOverlayControl x:Name="PART_ImageInfoOverlay" />
                            <viewer:SlideshowCountdownOverlay x:Name="PART_SlideshowCountdown" IsHitTestVisible="False" />

                            <!--  Above NavButtonsOverlay, whose full-size hit area blocks text selection  -->
                            <ui:MessageOverlayControl x:Name="PART_Message" />
                            <ui:MotionPhotoOverlayControl x:Name="PART_MotionOverlay" />
                        </Panel>
                    </viewer:ViewerControl>
                </Border>
                </Border>

                <!--  Tool host  -->
                <tool:ToolHostControl
                    x:Name="PART_ToolHost"
                    Grid.Row="1"
                    Background="{DynamicResource IG_ToolHostBackgroundBrush}" />
            </Grid>

            <!--  Gallery  -->
            <ui:GalleryControl
                x:Name="PART_Gallery"
                Grid.Row="2"
                IsContentVisible="{CompiledBinding ShowGallery, Source={x:Static cm:Core.Config}}"
                ItemsSource="{CompiledBinding Items, Source={x:Static cm:Core.Photos}}"
                ViewMode="FilmStrip"
                ZIndex="80" />

            <!--  Gallery resizer  -->
            <ui:PhGridSplitter
                x:Name="PART_GalleryResizer"
                Grid.Row="3"
                CornerRadius="1"
                DragCompleted="PART_GalleryResizer_DragCompleted"
                Focusable="False"
                IsVisible="False"
                ResizeDirection="Columns" />
        </Grid>

        <!--  Bottom Bar: 左图像规格摘要 + 右精巧缩放组 (32px 高精密质感底栏)  -->
        <Border Grid.Row="2" Background="{StaticResource WindowBottomBarGradient}"
                BorderBrush="#12FFFFFF"
                BorderThickness="0,1,0,0"
                Height="32"
                Padding="14,0" PointerPressed="BottomBar_PointerPressed">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <!-- 左侧图片摘要微信息条 -->
                <StackPanel x:Name="PART_StatusGroup" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="False">
                    <Border Background="#12FFFFFF" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                        <TextBlock x:Name="PART_StatusIndex" Foreground="#D1D5DB" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Border x:Name="PART_StatusFormatBadge" Background="#1E3B82F6" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                        <TextBlock x:Name="PART_StatusFormat" Foreground="#93C5FD" FontSize="10" FontWeight="Bold" />
                    </Border>
                    <TextBlock x:Name="PART_StatusSpecs" Foreground="#9CA3AF" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 右侧缩放控制组 -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <ui:PhToolButton Click="ZoomOutButton_Click" ToolTip.Tip="缩小" Width="24" Height="24" CornerRadius="5" Padding="0">
                        <TextBlock Foreground="#D1D5DB" Text="−" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ui:PhToolButton>
                    <Slider x:Name="PART_ZoomSlider" Width="180" Minimum="0" Maximum="1000"
                            VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged">
                        <Slider.Resources>
                            <SolidColorBrush x:Key="PhSliderTrackFill" Color="#3B82F6" />
                            <SolidColorBrush x:Key="PhSliderTrackFillPointerOver" Color="#60A5FA" />
                            <SolidColorBrush x:Key="PhSliderTrackFillPressed" Color="#2563EB" />
                        </Slider.Resources>
                    </Slider>
                    <ui:PhToolButton Click="ZoomInButton_Click" ToolTip.Tip="放大" Width="24" Height="24" CornerRadius="5" Padding="0">
                        <TextBlock Foreground="#D1D5DB" Text="+" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ui:PhToolButton>
                    <ui:PhToolButton Click="ZoomActualSizeButton_Click" ToolTip.Tip="原始大小" MinWidth="34" Height="22" Padding="6,0" CornerRadius="5" Background="#0DFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1">
                        <TextBlock Foreground="#E5E7EB" Text="1:1" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ui:PhToolButton>
                    <TextBlock Foreground="#D1D5DB" FontWeight="Medium" FontSize="11.5" x:Name="PART_ZoomPercentage" Width="46" VerticalAlignment="Center" TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>


        <!--  ======================================================  -->
        <!--  DELETE CONFIRMATION MODAL OVERLAY (精巧分层式删除确认弹窗)  -->
        <!--  ======================================================  -->
        <Grid x:Name="PART_DeleteModal" Grid.Row="0" Grid.RowSpan="3" IsVisible="False" ZIndex="1100">
            <Grid.Styles>
                <!--  精巧 15x15 复选框样式 (使用纯净隔离模板，悬停高亮柔和不再变黑)  -->
                <Style Selector="CheckBox#PART_DeleteRemember">
                    <Setter Property="Template" Value="{StaticResource ModalCleanCheckBoxTemplate}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#9CA3AF" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="MinHeight" Value="20" />
                </Style>
                <Style Selector="CheckBox#PART_DeleteRemember:pointerover">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#E5E7EB" />
                </Style>
                <Style Selector="CheckBox#PART_DeleteRemember:pressed">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#D1D5DB" />
                </Style>
                <Style Selector="CheckBox#PART_DeleteRemember:checked">
                    <Setter Property="Foreground" Value="#D1D5DB" />
                </Style>
                <Style Selector="CheckBox#PART_DeleteRemember:checked:pointerover">
                    <Setter Property="Foreground" Value="#F3F4F6" />
                </Style>
                <Style Selector="CheckBox#PART_DeleteRemember:checked:pressed">
                    <Setter Property="Foreground" Value="#E5E7EB" />
                </Style>
                <Style Selector="CheckBox#PART_DeleteRemember:unchecked /template/ Border#PART_ModalCheckBox">
                    <Setter Property="Background" Value="#181A1F" />
                    <Setter Property="BorderBrush" Value="#4B505C" />
                </Style>
                <Style Selector="CheckBox#PART_DeleteRemember:unchecked:pointerover /template/ Border#PART_ModalCheckBox">
                    <Setter Property="Background" Value="#242730" />
                    <Setter Property="BorderBrush" Value="#7B8294" />
                </Style>
                <Style Selector="CheckBox#PART_DeleteRemember:unchecked:pressed /template/ Border#PART_ModalCheckBox">
                    <Setter Property="Background" Value="#1D1F26" />
                    <Setter Property="BorderBrush" Value="#606778" />
                </Style>
                <Style Selector="CheckBox#PART_DeleteRemember:checked /template/ Border#PART_ModalCheckBox">
                    <Setter Property="Background" Value="#356BBF" />
                    <Setter Property="BorderBrush" Value="#4A85E0" />
                </Style>
                <Style Selector="CheckBox#PART_DeleteRemember:checked:pointerover /template/ Border#PART_ModalCheckBox">
                    <Setter Property="Background" Value="#407AD2" />
                    <Setter Property="BorderBrush" Value="#669DF6" />
                </Style>
                <Style Selector="CheckBox#PART_DeleteRemember:checked:pressed /template/ Border#PART_ModalCheckBox">
                    <Setter Property="Background" Value="#2B59A1" />
                    <Setter Property="BorderBrush" Value="#356BBF" />
                </Style>
                <Style Selector="CheckBox#PART_DeleteRemember:checked /template/ Path#PART_ModalCheckMark">
                    <Setter Property="Opacity" Value="1" />
                </Style>

                <!--  右上角微型关闭钮 (干净透明模板，和谐隐融不突兀)  -->
                <Style Selector="Button#PART_BtnCloseDeleteModal">
                    <Setter Property="Template" Value="{StaticResource ModalCleanButtonTemplate}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Width" Value="24" />
                    <Setter Property="Height" Value="24" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="Button#PART_BtnCloseDeleteModal:pointerover">
                    <Setter Property="Background" Value="#14FFFFFF" />
                </Style>
                <Style Selector="Button#PART_BtnCloseDeleteModal:pressed">
                    <Setter Property="Background" Value="#20FFFFFF" />
                </Style>

                <!--  次要按钮：取消 (承接主深灰同色系，柔和统一)  -->
                <Style Selector="Button#PART_DeleteCancel">
                    <Setter Property="Template" Value="{StaticResource ModalCleanButtonTemplate}" />
                    <Setter Property="Background" Value="#282B33" />
                    <Setter Property="BorderBrush" Value="#16FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="#D1D5DB" />
                    <Setter Property="FontSize" Value="12.5" />
                    <Setter Property="FontWeight" Value="Medium" />
                    <Setter Property="MinWidth" Value="74" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="CornerRadius" Value="7" />
                    <Setter Property="Padding" Value="14,0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="Button#PART_DeleteCancel:pointerover">
                    <Setter Property="Background" Value="#323640" />
                    <Setter Property="BorderBrush" Value="#24FFFFFF" />
                    <Setter Property="Foreground" Value="#F3F4F6" />
                </Style>
                <Style Selector="Button#PART_DeleteCancel:pressed">
                    <Setter Property="Background" Value="#22252C" />
                    <Setter Property="BorderBrush" Value="#12FFFFFF" />
                </Style>

                <!--  主危险按钮：是 (低饱和柔和暗珊瑚红，不再刺眼突兀)  -->
                <Style Selector="Button#PART_DeleteConfirm">
                    <Setter Property="Template" Value="{StaticResource ModalCleanButtonTemplate}" />
                    <Setter Property="Background" Value="{StaticResource DangerBtnGradient}" />
                    <Setter Property="BorderBrush" Value="#26FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="#F9FAFB" />
                    <Setter Property="FontSize" Value="12.5" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="MinWidth" Value="82" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="CornerRadius" Value="7" />
                    <Setter Property="Padding" Value="16,0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="Button#PART_DeleteConfirm:pointerover">
                    <Setter Property="Background" Value="{StaticResource DangerBtnHoverGradient}" />
                    <Setter Property="BorderBrush" Value="#38FFFFFF" />
                </Style>
                <Style Selector="Button#PART_DeleteConfirm:pressed">
                    <Setter Property="Background" Value="#8D2A2A" />
                    <Setter Property="BorderBrush" Value="#18FFFFFF" />
                </Style>
            </Grid.Styles>

            <!--  全屏柔暗压光遮罩  -->
            <Border Background="#7A000000" PointerPressed="DeleteBackdrop_PointerPressed" />

            <!--  精巧立体弹窗卡片 (396px 宽，顶光学高光描边 + 分层底座)  -->
            <Border
                Width="396"
                MaxWidth="420"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{StaticResource ModalGlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True"
                BoxShadow="0 24 64 0 #B3000000">
                <Grid RowDefinitions="*,Auto">
                    <!--  上部内容主体  -->
                    <Border Grid.Row="0" Padding="20,20,20,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#292C33" Offset="0.0" />
                                <GradientStop Color="#23252B" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <StackPanel Spacing="14">
                            <!--  头部：圆角 Squircle 警示微徽章 + 标题与描述 + 关闭钮  -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border
                                    Grid.Column="0"
                                    Width="34"
                                    Height="34"
                                    CornerRadius="9"
                                    Background="#1EEF4444"
                                    BorderBrush="#38EF4444"
                                    BorderThickness="1"
                                    VerticalAlignment="Top">
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Data="M6.442 2.5a2 2 0 0 1 2-2h3.046a2 2 0 0 1 2 2v.314c0 .036-.003.07-.01.105h4.952a.5.5 0 1 1 0 1h-.764l-1.558 13.507a2.5 2.5 0 0 1-2.484 2.214H6.306a2.5 2.5 0 0 1-2.484-2.214L2.264 3.92H1.5a.5.5 0 0 1 0-1h4.953a.502.502 0 0 1-.011-.105V2.5Zm.989.419h5.068a.501.501 0 0 1-.01-.105V2.5a1 1 0 0 0-1-1H8.441a1 1 0 0 0-1 1v.314c0 .036-.004.07-.011.105Zm-4.16 1L4.815 17.31a1.5 1.5 0 0 0 1.49 1.329h7.318a1.5 1.5 0 0 0 1.49-1.329L16.66 3.92H3.27Zm5.38 3.337a.5.5 0 1 0-1 0v7.256a.5.5 0 0 0 1 0V7.256Zm3.128-.5a.5.5 0 0 1 .5.5v7.256a.5.5 0 0 1-1 0V7.256a.5.5 0 0 1 .5-.5Z"
                                        Fill="#F87171"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,6,0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="PART_DeleteTitle"
                                        Foreground="#F3F4F6"
                                        FontSize="14.5"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="PART_DeleteHeading"
                                        Foreground="#9CA3AF"
                                        FontSize="12.5"
                                        LineHeight="17.5"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Button
                                    x:Name="PART_BtnCloseDeleteModal"
                                    Classes="link"
                                    Grid.Column="2"
                                    VerticalAlignment="Top"
                                    Click="DeleteCancel_Click">
                                    <Path
                                        Width="9.5"
                                        Height="9.5"
                                        Data="{StaticResource IconClose}"
                                        Fill="#8E95A2"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Button>
                            </Grid>

                            <!--  内嵌文件信息胶囊槽 (拆分高亮文件名与次要路径体积)  -->
                            <Border
                                Background="#191B20"
                                BorderBrush="#10FFFFFF"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="11,10">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border
                                        Grid.Column="0"
                                        Width="30"
                                        Height="30"
                                        CornerRadius="7"
                                        Background="#242730"
                                        BorderBrush="#0DFFFFFF"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                        <Path
                                            Width="14.5"
                                            Height="14.5"
                                            Data="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5Zm14 0H6v10.586l3.293-3.293a1 1 0 0 1 1.414 0L14 15.586l1.293-1.293a1 1 0 0 1 1.414 0L18 15.586V5Zm0 13.414-2-2-1.293 1.293a1 1 0 0 1-1.414 0L10 14.414l-4 4V19h12v-.586ZM15.5 9.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"
                                            Fill="#60A5FA"
                                            Stretch="Uniform"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2.5" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="PART_DeleteFileName"
                                            Foreground="#F3F4F6"
                                            FontSize="12.5"
                                            FontWeight="Medium"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            x:Name="PART_DeletePath"
                                            Foreground="#8B92A0"
                                            FontSize="11"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  不再提示选项  -->
                            <CheckBox x:Name="PART_DeleteRemember" Margin="2,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!--  下部独立沉稳动作底座  -->
                    <Border
                        Grid.Row="1"
                        Background="#1C1E23"
                        BorderBrush="#10FFFFFF"
                        BorderThickness="0,1,0,0"
                        Padding="20,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button x:Name="PART_DeleteCancel" Classes="link" Click="DeleteCancel_Click" />
                            <Button x:Name="PART_DeleteConfirm" Classes="link" Click="DeleteConfirm_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  ======================================================  -->
        <!--  IMAGE INFO MODAL OVERLAY (图片信息遮盖层 - 精工统一暗色风格) -->
        <!--  ======================================================  -->
        <Grid
            x:Name="PART_ImageInfoModal"
            Grid.Row="0"
            Grid.RowSpan="3"
            IsVisible="False"
            ZIndex="1000">
            <Grid.Styles>
                <!-- 复制按钮 -->
                <Style Selector="Button#PART_BtnCopyImageInfo">
                    <Setter Property="Template" Value="{StaticResource ModalCleanButtonTemplate}" />
                    <Setter Property="Background" Value="#282B33" />
                    <Setter Property="BorderBrush" Value="#16FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="#D1D5DB" />
                    <Setter Property="Height" Value="26" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="Button#PART_BtnCopyImageInfo:pointerover">
                    <Setter Property="Background" Value="#323640" />
                    <Setter Property="BorderBrush" Value="#24FFFFFF" />
                </Style>
                <Style Selector="Button#PART_BtnCopyImageInfo:pressed">
                    <Setter Property="Background" Value="#22252C" />
                </Style>

                <!-- 关闭按钮 -->
                <Style Selector="Button#PART_BtnCloseImageInfo">
                    <Setter Property="Template" Value="{StaticResource ModalCleanButtonTemplate}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Width" Value="26" />
                    <Setter Property="Height" Value="26" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="Button#PART_BtnCloseImageInfo:pointerover">
                    <Setter Property="Background" Value="#14FFFFFF" />
                </Style>
                <Style Selector="Button#PART_BtnCloseImageInfo:pressed">
                    <Setter Property="Background" Value="#20FFFFFF" />
                </Style>

                <!-- 打开文件夹按钮 -->
                <Style Selector="Button#PART_BtnOpenFolder">
                    <Setter Property="Template" Value="{StaticResource ModalCleanButtonTemplate}" />
                    <Setter Property="Background" Value="#282B33" />
                    <Setter Property="BorderBrush" Value="#16FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="#D1D5DB" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="Button#PART_BtnOpenFolder:pointerover">
                    <Setter Property="Background" Value="#323640" />
                    <Setter Property="BorderBrush" Value="#24FFFFFF" />
                </Style>
                <Style Selector="Button#PART_BtnOpenFolder:pressed">
                    <Setter Property="Background" Value="#22252C" />
                </Style>

                <!-- 完成按钮 -->
                <Style Selector="Button#PART_BtnDoneImageInfo">
                    <Setter Property="Template" Value="{StaticResource ModalCleanButtonTemplate}" />
                    <Setter Property="Background" Value="{StaticResource ModalAccentBtnGradient}" />
                    <Setter Property="BorderBrush" Value="#26FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="#F9FAFB" />
                    <Setter Property="MinWidth" Value="76" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="Padding" Value="16,0" />
                    <Setter Property="CornerRadius" Value="7" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="Button#PART_BtnDoneImageInfo:pointerover">
                    <Setter Property="Background" Value="{StaticResource ModalAccentBtnHoverGradient}" />
                    <Setter Property="BorderBrush" Value="#38FFFFFF" />
                </Style>
                <Style Selector="Button#PART_BtnDoneImageInfo:pressed">
                    <Setter Property="Background" Value="#224987" />
                </Style>
            </Grid.Styles>

            <!--  Frosted Mask / Backdrop (点击背景关闭)  -->
            <Border
                x:Name="PART_ImageInfoBackdrop"
                Background="#7A000000"
                PointerPressed="ImageInfoBackdrop_PointerPressed" />

            <!--  Centered Floating Metadata Card  -->
            <Border
                Width="460"
                MaxWidth="480"
                Margin="16"
                MaxHeight="580"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{StaticResource ModalGlassBorderBrush}"
                BorderThickness="1"
                BoxShadow="0 24 64 0 #B3000000"
                CornerRadius="14"
                ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#292C33" Offset="0.0" />
                        <GradientStop Color="#23252B" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid RowDefinitions="Auto,*,Auto">

                    <!--  Card Header  -->
                    <Border
                        Grid.Row="0"
                        Padding="18,13"
                        BorderBrush="#10FFFFFF"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border
                                    Width="28"
                                    Height="28"
                                    CornerRadius="7"
                                    Background="#1E3B82F6"
                                    BorderBrush="#333B82F6"
                                    BorderThickness="1">
                                    <Path
                                        Width="14"
                                        Height="14"
                                        Data="{StaticResource IconInfo}"
                                        Fill="#60A5FA"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <TextBlock
                                    FontSize="14.5"
                                    FontWeight="SemiBold"
                                    Foreground="#F3F4F6"
                                    VerticalAlignment="Center"
                                    Text="图片信息" />
                            </StackPanel>

                            <!-- Copy Button & Close Button -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <Button
                                    x:Name="PART_BtnCopyImageInfo"
                                    Classes="link"
                                    Click="BtnCopyImageInfo_Click"
                                    ToolTip.Tip="复制全部图片信息">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Path
                                            Width="11.5"
                                            Height="11.5"
                                            VerticalAlignment="Center"
                                            Data="{StaticResource IconCopy}"
                                            Fill="#D1D5DB"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            x:Name="PART_TxtCopyImageInfo"
                                            FontSize="11.5"
                                            Foreground="#D1D5DB"
                                            VerticalAlignment="Center"
                                            Text="复制" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    x:Name="PART_BtnCloseImageInfo"
                                    Classes="link"
                                    Click="BtnCloseImageInfo_Click">
                                    <Path
                                        Width="9.5"
                                        Height="9.5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource IconClose}"
                                        Fill="#8E95A2"
                                        Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Card Body (Scrollable)  -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18,14" Spacing="13">

                            <!-- Overview Card (文件名与徽标) -->
                            <Border
                                Padding="13,11"
                                Background="#191B20"
                                BorderBrush="#10FFFFFF"
                                BorderThickness="1"
                                CornerRadius="9">
                                <StackPanel Spacing="9">
                                    <SelectableTextBlock
                                        x:Name="PART_InfoFileName"
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Foreground="#F3F4F6"
                                        TextWrapping="Wrap" />

                                    <!-- Chips / Badges Row -->
                                    <WrapPanel Orientation="Horizontal">
                                        <!-- Format Chip -->
                                        <Border x:Name="PART_ChipFormat" Margin="0,0,6,0" Padding="7,2.5" Background="#243B82F6" BorderBrush="#403B82F6" BorderThickness="1" CornerRadius="5">
                                            <TextBlock x:Name="PART_InfoFormatText" FontSize="10.5" FontWeight="Bold" Foreground="#93C5FD" />
                                        </Border>
                                        <!-- Dimensions Chip -->
                                        <Border Margin="0,0,6,0" Padding="7,2.5" Background="#12FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="5">
                                            <TextBlock x:Name="PART_InfoDimensionsText" FontSize="11" FontWeight="Medium" Foreground="#D1D5DB" />
                                        </Border>
                                        <!-- Megapixels Chip -->
                                        <Border x:Name="PART_ChipMegapixels" Margin="0,0,6,0" Padding="7,2.5" Background="#12FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="5">
                                            <TextBlock x:Name="PART_InfoMegapixelsText" FontSize="11" FontWeight="Medium" Foreground="#D1D5DB" />
                                        </Border>
                                        <!-- File Size Chip -->
                                        <Border Margin="0,0,6,0" Padding="7,2.5" Background="#12FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="5">
                                            <TextBlock x:Name="PART_InfoFileSizeText" FontSize="11" FontWeight="Medium" Foreground="#D1D5DB" />
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- EXIF / Shooting Parameters (拍照参数, if available) -->
                            <StackPanel x:Name="PART_SectionExif" Spacing="6">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#8B92A0" Text="拍摄参数 (EXIF)" />
                                <Border Padding="12,10" Background="#191B20" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="9">
                                    <StackPanel Spacing="9">
                                        <!-- Camera Model -->
                                        <TextBlock x:Name="PART_InfoCameraModel" FontSize="12.5" FontWeight="Medium" Foreground="#E5E7EB" TextWrapping="Wrap" />
                                        <!-- Exposure 4-col Grid -->
                                        <Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,0">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock FontSize="10.5" Foreground="#8B92A0" Text="光圈" />
                                                <TextBlock x:Name="PART_InfoAperture" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3F4F6" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock FontSize="10.5" Foreground="#8B92A0" Text="快门" />
                                                <TextBlock x:Name="PART_InfoShutter" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3F4F6" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock FontSize="10.5" Foreground="#8B92A0" Text="感光度" />
                                                <TextBlock x:Name="PART_InfoIso" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3F4F6" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Spacing="2">
                                                <TextBlock FontSize="10.5" Foreground="#8B92A0" Text="焦距" />
                                                <TextBlock x:Name="PART_InfoFocalLength" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3F4F6" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Image Details (色彩、分辨率、帧数) -->
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#8B92A0" Text="图像规格" />
                                <Border Padding="12,9" Background="#191B20" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="9">
                                    <StackPanel Spacing="7">
                                        <!-- Color Space -->
                                        <Grid ColumnDefinitions="92, *">
                                            <TextBlock Grid.Column="0" FontSize="11.5" Foreground="#8B92A0" Text="色彩空间" />
                                            <SelectableTextBlock x:Name="PART_InfoColorSpace" Grid.Column="1" FontSize="11.5" Foreground="#E5E7EB" />
                                        </Grid>
                                        <!-- DPI -->
                                        <Grid ColumnDefinitions="92, *">
                                            <TextBlock Grid.Column="0" FontSize="11.5" Foreground="#8B92A0" Text="分辨率" />
                                            <SelectableTextBlock x:Name="PART_InfoDpi" Grid.Column="1" FontSize="11.5" Foreground="#E5E7EB" />
                                        </Grid>
                                        <!-- Frames -->
                                        <Grid x:Name="PART_RowFrames" ColumnDefinitions="92, *">
                                            <TextBlock Grid.Column="0" FontSize="11.5" Foreground="#8B92A0" Text="帧数" />
                                            <SelectableTextBlock x:Name="PART_InfoFrames" Grid.Column="1" FontSize="11.5" Foreground="#E5E7EB" />
                                        </Grid>
                                        <!-- HDR / Live -->
                                        <Grid x:Name="PART_RowHdr" ColumnDefinitions="92, *">
                                            <TextBlock Grid.Column="0" FontSize="11.5" Foreground="#8B92A0" Text="特性" />
                                            <SelectableTextBlock x:Name="PART_InfoFeatures" Grid.Column="1" FontSize="11.5" Foreground="#E5E7EB" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Storage & Dates (时间与路径) -->
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#8B92A0" Text="时间与存储" />
                                <Border Padding="12,9" Background="#191B20" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="9">
                                    <StackPanel Spacing="7">
                                        <!-- Date Taken / Created -->
                                        <Grid ColumnDefinitions="92, *">
                                            <TextBlock Grid.Column="0" FontSize="11.5" Foreground="#8B92A0" Text="拍摄/创建" />
                                            <SelectableTextBlock x:Name="PART_InfoDateCreated" Grid.Column="1" FontSize="11.5" Foreground="#E5E7EB" />
                                        </Grid>
                                        <!-- Date Modified -->
                                        <Grid ColumnDefinitions="92, *">
                                            <TextBlock Grid.Column="0" FontSize="11.5" Foreground="#8B92A0" Text="修改时间" />
                                            <SelectableTextBlock x:Name="PART_InfoDateModified" Grid.Column="1" FontSize="11.5" Foreground="#E5E7EB" />
                                        </Grid>
                                        <!-- File Path -->
                                        <Grid ColumnDefinitions="92, *">
                                            <TextBlock Grid.Column="0" FontSize="11.5" Foreground="#8B92A0" Text="文件路径" />
                                            <SelectableTextBlock x:Name="PART_InfoFilePath" Grid.Column="1" FontSize="11" Foreground="#D1D5DB" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!--  Card Footer (沉稳独立底座)  -->
                    <Border
                        Grid.Row="2"
                        Background="#1C1E23"
                        Padding="18,11"
                        BorderBrush="#10FFFFFF"
                        BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <Button
                                x:Name="PART_BtnOpenFolder"
                                Classes="link"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                Click="BtnOpenFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path
                                        Width="12.5"
                                        Height="12.5"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource IconFolderOpen}"
                                        Fill="#D1D5DB"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#D1D5DB"
                                        VerticalAlignment="Center"
                                        Text="打开所在文件夹" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="PART_BtnDoneImageInfo"
                                Classes="link"
                                Grid.Column="1"
                                Click="BtnCloseImageInfo_Click">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#F9FAFB" Text="完成" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</ui:PhControl>
