<UserControl
    x:Class="ImageGlass.Common.Windows.SettingsOverlayControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windows="using:ImageGlass.Common.Windows"
    mc:Ignorable="d"
    d:DesignHeight="640"
    d:DesignWidth="920"
    x:Name="Root">

    <UserControl.Resources>
        <!--  弹窗光学顶高光玻璃描边  -->
        <LinearGradientBrush x:Key="SettingsGlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource IgDarkColor36FFFFFF}" Offset="0.0" />
            <GradientStop Color="{DynamicResource IgDarkColor16FFFFFF}" Offset="0.45" />
            <GradientStop Color="{DynamicResource IgDarkColor0BFFFFFF}" Offset="1.0" />
        </LinearGradientBrush>

        <!--  设计蓝主动作渐变  -->
        <LinearGradientBrush x:Key="SettingsAccentBtnGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource IgDarkColor356BBF}" Offset="0.0" />
            <GradientStop Color="{DynamicResource IgDarkColor2B59A1}" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SettingsAccentBtnHoverGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource IgDarkColor407AD2}" Offset="0.0" />
            <GradientStop Color="{DynamicResource IgDarkColor3368B8}" Offset="1.0" />
        </LinearGradientBrush>

        <!--  彻底隔离浅色主题 TextControl / Button 默认刷子  -->
        <SolidColorBrush x:Key="PhButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="PhButtonBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="PhButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource IgDarkColorF3F4F6}" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{DynamicResource IgDarkColorFFFFFF}" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{DynamicResource IgDarkColorFFFFFF}" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{DynamicResource IgDarkColor6F7685}" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{DynamicResource IgDarkColor848C9C}" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{DynamicResource IgDarkColor6F7685}" />
        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{DynamicResource IgDarkColor553B82F6}" />

        <!--  干净按钮模板：彻底屏蔽全局 ButtonStyle 浅色干扰  -->
        <ControlTemplate x:Key="OverlayCleanButtonTemplate" TargetType="Button">
            <Border
                x:Name="PART_OverlayBtnBorder"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
                <ContentPresenter
                    x:Name="PART_OverlayBtnContent"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    Foreground="{TemplateBinding Foreground}" />
            </Border>
        </ControlTemplate>

        <!--  外观模式可视化选择卡片模板 (System / Dark / Light)  -->
        <ControlTemplate x:Key="AppearanceModeCardTemplate" TargetType="RadioButton">
            <Border
                x:Name="PART_CardRoot"
                Padding="10"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Cursor="Hand">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.14" />
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                    </Transitions>
                </Border.Transitions>
                <ContentPresenter
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
        </ControlTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  左侧导航项按钮  -->
        <Style Selector="Button.settings-nav-btn">
            <Setter Property="Template" Value="{StaticResource OverlayCleanButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrush9CA3AF}" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.settings-nav-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush0CFFFFFF}" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushE5E7EB}" />
        </Style>
        <Style Selector="Button.settings-nav-btn.active">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush1E3B82F6}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush3260A5FA}" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushF3F4F6}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.settings-nav-btn Path.nav-icon">
            <Setter Property="Fill" Value="{DynamicResource IgDarkBrush7A8291}" />
        </Style>
        <Style Selector="Button.settings-nav-btn:pointerover Path.nav-icon">
            <Setter Property="Fill" Value="{DynamicResource IgDarkBrushD1D5DB}" />
        </Style>
        <Style Selector="Button.settings-nav-btn.active Path.nav-icon">
            <Setter Property="Fill" Value="{DynamicResource IgDarkBrush60A5FA}" />
        </Style>
        <Style Selector="Button.settings-nav-btn Border.nav-indicator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.settings-nav-btn.active Border.nav-indicator">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!--  输入凹槽外框  -->
        <Style Selector="Border.overlay-input-box">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush15171C}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush1CFFFFFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.overlay-input-box:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush2EFFFFFF}" />
        </Style>
        <Style Selector="Border.overlay-input-box:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush3B82F6}" />
        </Style>
        <Style Selector="Border.overlay-input-box.invalid">
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrushEF4444}" />
        </Style>

        <!--  内部输入框透明化，防止出现白色边框/聚焦高亮黑字  -->
        <Style Selector="TextBox.overlay-textbox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushF3F4F6}" />
            <Setter Property="CaretBrush" Value="#60A5FA" />
            <Setter Property="SelectionBrush" Value="#553B82F6" />
            <Setter Property="SelectionForegroundBrush" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.overlay-textbox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.overlay-textbox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.overlay-textbox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!--  右上角微关闭钮 & 图标小按钮  -->
        <Style Selector="Button.overlay-icon-btn">
            <Setter Property="Template" Value="{StaticResource OverlayCleanButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.overlay-icon-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush14FFFFFF}" />
        </Style>
        <Style Selector="Button.overlay-icon-btn:pressed">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush22FFFFFF}" />
        </Style>

        <!--  次要深灰胶囊按钮  -->
        <Style Selector="Button.overlay-secondary-btn">
            <Setter Property="Template" Value="{StaticResource OverlayCleanButtonTemplate}" />
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush282B33}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush16FFFFFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushD1D5DB}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.overlay-secondary-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush323640}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush24FFFFFF}" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushF3F4F6}" />
        </Style>
        <Style Selector="Button.overlay-secondary-btn:pressed">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush22252C}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush12FFFFFF}" />
        </Style>
        <Style Selector="Button.overlay-secondary-btn:disabled">
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <!--  微强调冷蓝胶囊按钮  -->
        <Style Selector="Button.overlay-soft-accent-btn">
            <Setter Property="Template" Value="{StaticResource OverlayCleanButtonTemplate}" />
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush1E3B82F6}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush4860A5FA}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrush93C5FD}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.overlay-soft-accent-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush2D3B82F6}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush6860A5FA}" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushBFDBFE}" />
        </Style>
        <Style Selector="Button.overlay-soft-accent-btn:pressed">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush183B82F6}" />
        </Style>
        <Style Selector="Button.overlay-soft-accent-btn:disabled">
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <!--  主蓝确认保存按钮  -->
        <Style Selector="Button.overlay-primary-btn">
            <Setter Property="Template" Value="{StaticResource OverlayCleanButtonTemplate}" />
            <Setter Property="Background" Value="{StaticResource SettingsAccentBtnGradient}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush26FFFFFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushF9FAFB}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.overlay-primary-btn:pointerover">
            <Setter Property="Background" Value="{StaticResource SettingsAccentBtnHoverGradient}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush38FFFFFF}" />
        </Style>
        <Style Selector="Button.overlay-primary-btn:pressed">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush224987}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush18FFFFFF}" />
        </Style>
        <Style Selector="Button.overlay-primary-btn:disabled">
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <!--  分段过滤药丸按钮  -->
        <Style Selector="Button.overlay-filter-pill">
            <Setter Property="Template" Value="{StaticResource OverlayCleanButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrush8E95A2}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.overlay-filter-pill:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush12FFFFFF}" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushE5E7EB}" />
        </Style>
        <Style Selector="Button.overlay-filter-pill.active">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush263B82F6}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush4060A5FA}" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrush93C5FD}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  预设背景色块按钮  -->
        <Style Selector="Button.bg-swatch-btn">
            <Setter Property="Template" Value="{StaticResource OverlayCleanButtonTemplate}" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush24FFFFFF}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.bg-swatch-btn:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush66FFFFFF}" />
        </Style>
        <Style Selector="Button.bg-swatch-btn.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush60A5FA}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!--  主题卡内深色/浅色切换钮  -->
        <Style Selector="Button.theme-mode-pill">
            <Setter Property="Template" Value="{StaticResource OverlayCleanButtonTemplate}" />
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush242730}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush14FFFFFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrush9CA3AF}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="27" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.theme-mode-pill:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush2E323D}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush28FFFFFF}" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushE5E7EB}" />
        </Style>
        <Style Selector="Button.theme-mode-pill.selected">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush263B82F6}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush5C60A5FA}" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrush93C5FD}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.theme-mode-pill Path">
            <Setter Property="Fill" Value="{DynamicResource IgDarkBrush7A8291}" />
        </Style>
        <Style Selector="Button.theme-mode-pill:pointerover Path">
            <Setter Property="Fill" Value="{DynamicResource IgDarkBrushD1D5DB}" />
        </Style>
        <Style Selector="Button.theme-mode-pill.selected Path">
            <Setter Property="Fill" Value="{DynamicResource IgDarkBrush60A5FA}" />
        </Style>

        <!--  行内删除动作按钮  -->
        <Style Selector="Button.format-delete-btn">
            <Setter Property="Template" Value="{StaticResource OverlayCleanButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrush6F7785}" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.format-delete-btn Path">
            <Setter Property="Fill" Value="{DynamicResource IgDarkBrush6F7785}" />
        </Style>
        <Style Selector="Button.format-delete-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush24EF4444}" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushF87171}" />
        </Style>
        <Style Selector="Button.format-delete-btn:pointerover Path">
            <Setter Property="Fill" Value="{DynamicResource IgDarkBrushF87171}" />
        </Style>
        <Style Selector="Button.format-delete-btn:pressed">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush36EF4444}" />
        </Style>

        <!--  紧凑微链接按钮  -->
        <Style Selector="Button.overlay-micro-link">
            <Setter Property="Template" Value="{StaticResource OverlayCleanButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrush7AB0FA}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.overlay-micro-link:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush143B82F6}" />
            <Setter Property="Foreground" Value="{DynamicResource IgDarkBrushA8CCFC}" />
        </Style>

        <!--  主题包卡片悬浮质感  -->
        <Style Selector="Border.theme-pack-card">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush191B20}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush12FFFFFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.theme-pack-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush3860A5FA}" />
        </Style>

        <!--  格式列表行悬浮质感  -->
        <Style Selector="Border.format-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush0AFFFFFF}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style Selector="Border.format-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush0CFFFFFF}" />
        </Style>
        <Style Selector="Border.format-row.highlighted">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush1E3B82F6}" />
        </Style>

        <!--  外观模式可视化选择卡片样式 (System / Dark / Light)  -->
        <Style Selector="RadioButton.appearance-card">
            <Setter Property="Template" Value="{StaticResource AppearanceModeCardTemplate}" />
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush181A20}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush14FFFFFF}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="RadioButton.appearance-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush1F222A}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush3260A5FA}" />
        </Style>
        <Style Selector="RadioButton.appearance-card:checked">
            <Setter Property="Background" Value="{DynamicResource IgIconBlueSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgIconBlueBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="RadioButton.appearance-card:disabled">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="RadioButton.appearance-card Border.appearance-check-ring">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgDarkBrush36FFFFFF}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="RadioButton.appearance-card:pointerover Border.appearance-check-ring">
            <Setter Property="BorderBrush" Value="{DynamicResource IgIconBlueBrush}" />
        </Style>
        <Style Selector="RadioButton.appearance-card:checked Border.appearance-check-ring">
            <Setter Property="Background" Value="{DynamicResource IgIconBlueBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgIconBlueBrush}" />
        </Style>
        <Style Selector="RadioButton.appearance-card Path.appearance-check-mark">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="RadioButton.appearance-card:checked Path.appearance-check-mark">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!--  全屏柔暗压光遮罩 (点击卡片外区域取消关闭)  -->
        <Border Background="{DynamicResource IgDarkBrush7A000000}" />

        <!--  内部暗黑作用域，保障 ScrollBar、ToolTip 及文本菜单均为深色分支  -->
        <ThemeVariantScope>
            <!--  居中双栏现代工作室设置卡片  -->
            <Border
                x:Name="PART_SettingsCard"
                Margin="24,18"
                MinWidth="480"
                MaxWidth="860"
                Height="600"
                MaxHeight="600"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                BorderBrush="{StaticResource SettingsGlassBorderBrush}"
                BorderThickness="1"
                BoxShadow="0 24 64 0 #B3000000"
                ClipToBounds="True"
                CornerRadius="14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource IgDarkColor292C33}" Offset="0.0" />
                        <GradientStop Color="{DynamicResource IgDarkColor23252B}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Panel>
                    <Grid RowDefinitions="*,Auto">

                        <!--  ======================================================  -->
                        <!--  MAIN TWO-COLUMN WORKBENCH (左纤细导航 | 右内容工作区)  -->
                        <!--  ======================================================  -->
                        <Grid Grid.Row="0" ColumnDefinitions="188,*">

                            <!--  左栏：可扩展偏好导航区  -->
                            <Border
                                Grid.Column="0"
                                Background="{DynamicResource IgDarkBrush1B1D22}"
                                BorderBrush="{DynamicResource IgDarkBrush10FFFFFF}"
                                BorderThickness="0,0,1,0">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <!--  设置品牌标识头  -->
                                    <StackPanel Grid.Row="0" Margin="16,16,14,10" Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <Border
                                                Width="26"
                                                Height="26"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource IgIconIndigoSoftBrush}"
                                                BorderBrush="{DynamicResource IgDarkBrush3A3B82F6}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                                <Path
                                                    Width="13"
                                                    Height="13"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="{StaticResource IconSettings}"
                                                    Fill="{DynamicResource IgIconIndigoBrush}"
                                                    Stretch="Uniform" />
                                            </Border>
                                            <TextBlock
                                                x:Name="PART_SidebarTitle"
                                                VerticalAlignment="Center"
                                                FontSize="14.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource IgDarkBrushF3F4F6}"
                                                Text="设置" />
                                        </StackPanel>

                                        <TextBlock
                                            x:Name="PART_SidebarGroupLabel"
                                            Margin="2,4,0,0"
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource IgDarkBrush636B78}"
                                            Text="偏好配置" />
                                    </StackPanel>

                                    <!--  导航条目列表 (支持后续平滑追加新设置项)  -->
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <!--  1. 主题  -->
                                        <Button
                                            x:Name="PART_NavTheme"
                                            Classes="link settings-nav-btn active"
                                            Click="NavTab_Click"
                                            Tag="theme">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                                    <Border
                                                        Classes="nav-indicator"
                                                        Width="3"
                                                        Height="14"
                                                        Margin="-6,0,2,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource IgDarkBrush60A5FA}"
                                                        CornerRadius="1.5" />
                                                    <Border
                                                        Width="22"
                                                        Height="22"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource IgIconAmberSoftBrush}"
                                                        CornerRadius="6">
                                                        <Path
                                                            Width="12"
                                                            Height="12"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Data="{StaticResource IconWeatherMoon}"
                                                            Fill="{DynamicResource IgIconAmberBrush}"
                                                            Stretch="Uniform" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    x:Name="PART_TxtNavTheme"
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12.5"
                                                    Text="主题" />
                                                <Ellipse
                                                    x:Name="PART_NavThemeDirtyDot"
                                                    Grid.Column="2"
                                                    Width="6"
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Fill="{DynamicResource IgDarkBrushFBBF24}"
                                                    IsVisible="False" />
                                            </Grid>
                                        </Button>

                                        <!--  2. 关联格式  -->
                                        <Button
                                            x:Name="PART_NavAssociations"
                                            Classes="link settings-nav-btn"
                                            Click="NavTab_Click"
                                            Tag="associations">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                                    <Border
                                                        Classes="nav-indicator"
                                                        Width="3"
                                                        Height="14"
                                                        Margin="-6,0,2,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource IgIconCyanBrush}"
                                                        CornerRadius="1.5" />
                                                    <Border
                                                        Width="22"
                                                        Height="22"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource IgIconCyanSoftBrush}"
                                                        CornerRadius="6">
                                                        <Path
                                                            Width="11.5"
                                                            Height="11.5"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Data="M4 5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5Zm9-.5V8h3.5L13 4.5ZM7.5 11.5h9a.75.75 0 0 1 0 1.5h-9a.75.75 0 0 1 0-1.5Zm0 3.5h6a.75.75 0 0 1 0 1.5h-6a.75.75 0 0 1 0-1.5Z"
                                                            Fill="{DynamicResource IgIconCyanBrush}"
                                                            Stretch="Uniform" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    x:Name="PART_TxtNavAssociations"
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12.5"
                                                    Text="关联格式" />
                                                <Ellipse
                                                    x:Name="PART_NavAssocDirtyDot"
                                                    Grid.Column="2"
                                                    Width="6"
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Fill="{DynamicResource IgDarkBrushFBBF24}"
                                                    IsVisible="False" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="PART_NavAbout" Classes="link settings-nav-btn" Click="NavTab_Click" Tag="about">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                                    <Border Classes="nav-indicator" Width="3" Height="14" Margin="-6,0,2,0" VerticalAlignment="Center" Background="{DynamicResource IgIconCyanBrush}" CornerRadius="1.5" />
                                                    <Border Width="22" Height="22" VerticalAlignment="Center" Background="{DynamicResource IgIconCyanSoftBrush}" CornerRadius="6">
                                                        <Path Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource IconInfo}" Fill="{DynamicResource IgIconCyanBrush}" Stretch="Uniform" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="PART_TxtNavAbout" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5" Text="关于" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>

                                    <!--  底部轻提示  -->
                                    <Border
                                        Grid.Row="2"
                                        Margin="12,0,12,12"
                                        Padding="9,6"
                                        Background="{DynamicResource IgDarkBrush10FFFFFF}"
                                        BorderBrush="{DynamicResource IgDarkBrush0AFFFFFF}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                        <TextBlock
                                            x:Name="PART_SidebarTip"
                                            FontSize="10.5"
                                            Foreground="{DynamicResource IgDarkBrush6F7785}"
                                            Text="按 Esc 关闭弹窗"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!--  右栏：动态标题头 + 分页画布  -->
                            <Grid Grid.Column="1" RowDefinitions="Auto,*">

                                <!--  右侧共享顶部页头  -->
                                <Border
                                    Grid.Row="0"
                                    Padding="22,14,18,13"
                                    BorderBrush="{DynamicResource IgDarkBrush10FFFFFF}"
                                    BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                x:Name="PART_SectionTitle"
                                                FontSize="15.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource IgDarkBrushF3F4F6}" />
                                            <TextBlock
                                                x:Name="PART_SectionSubtitle"
                                                FontSize="11.5"
                                                Foreground="{DynamicResource IgDarkBrush8B92A0}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!--  页头右侧状态/操作插槽（按页显隐）  -->
                                        <StackPanel
                                            x:Name="PART_ThemeHeaderActions"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                x:Name="PART_BtnInstallTheme"
                                                Classes="link overlay-soft-accent-btn"
                                                Height="28"
                                                Padding="11,0"
                                                Click="InstallTheme_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Path
                                                        Width="10.5"
                                                        Height="10.5"
                                                        VerticalAlignment="Center"
                                                        Data="{StaticResource IconAdd}"
                                                        Fill="{DynamicResource IgDarkBrush93C5FD}"
                                                        Stretch="Uniform" />
                                                    <TextBlock x:Name="PART_TxtInstallTheme" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                x:Name="PART_BtnRefreshThemes"
                                                Classes="link overlay-icon-btn"
                                                Click="RefreshThemes_Click">
                                                <Path
                                                    Width="13"
                                                    Height="13"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="{StaticResource IconReset}"
                                                    Fill="{DynamicResource IgDarkBrush9CA3AF}"
                                                    Stretch="Uniform" />
                                            </Button>

                                            <Button
                                                x:Name="PART_BtnOpenThemeFolder"
                                                Classes="link overlay-icon-btn"
                                                Click="OpenThemeFolder_Click">
                                                <Path
                                                    Width="13"
                                                    Height="13"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="{StaticResource IconFolderOpen}"
                                                    Fill="{DynamicResource IgDarkBrush9CA3AF}"
                                                    Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>

                                        <Border
                                            x:Name="PART_AssocHeaderBadge"
                                            Grid.Column="1"
                                            Padding="10,4"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource IgDarkBrush191B20}"
                                            BorderBrush="{DynamicResource IgDarkBrush14FFFFFF}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            IsVisible="False">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse
                                                    x:Name="PART_AssocCountDot"
                                                    Width="6"
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Fill="{DynamicResource IgDarkBrush60A5FA}" />
                                                <TextBlock
                                                    x:Name="PART_TotalFormatsText"
                                                    VerticalAlignment="Center"
                                                    FontSize="11.5"
                                                    FontWeight="Medium"
                                                    Foreground="{DynamicResource IgDarkBrushD1D5DB}" />
                                            </StackPanel>
                                        </Border>

                                        <!--  右上角关闭钮  -->
                                        <Button
                                            x:Name="PART_BtnClose"
                                            Classes="link overlay-icon-btn"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Click="Cancel_Click">
                                            <Path
                                                Width="9.5"
                                                Height="9.5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource IconClose}"
                                                Fill="{DynamicResource IgDarkBrush8E95A2}"
                                                Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!--  右侧内容分页区  -->
                                <Panel Grid.Row="1">
                                    <windows:AboutOverlayControl x:Name="PART_AboutPage" IsVisible="False" />

                                    <!--  ================================================  -->
                                    <!--  PAGE 1: 主题与外观 (PART_PageTheme)               -->
                                    <!--  ================================================  -->
                                    <!--  ================================================  -->
                                    <!--  PAGE 1A: 主题外观风格 (PART_AppearancePage)         -->
                                    <!--  ================================================  -->
                                    <ScrollViewer
                                        x:Name="PART_AppearancePage"
                                        HorizontalScrollBarVisibility="Disabled"
                                        IsVisible="False"
                                        VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="22,18,22,20" Spacing="16">

                                            <!--  1.1 标题栏 + 当前生效模式实时徽章  -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <TextBlock
                                                        x:Name="PART_AppearanceTitle"
                                                        FontSize="13.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource IgDarkBrushF3F4F6}"
                                                        Text="外观模式" />
                                                    <TextBlock
                                                        x:Name="PART_AppearanceDesc"
                                                        FontSize="11.5"
                                                        Foreground="{DynamicResource IgDarkBrush8B92A0}"
                                                        Text="选择应用外观，跟随系统时将随 macOS 自动切换深浅主题。"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Border
                                                    x:Name="PART_CurrentThemeStatusBadge"
                                                    Grid.Column="1"
                                                    Padding="10,5"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource IgIconPurpleSoftBrush}"
                                                    BorderBrush="{DynamicResource IgDarkBrush18FFFFFF}"
                                                    BorderThickness="1"
                                                    CornerRadius="14">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Path
                                                            x:Name="PART_CurrentThemeStatusIcon"
                                                            Width="12"
                                                            Height="12"
                                                            VerticalAlignment="Center"
                                                            Data="{StaticResource IconWeatherMoon}"
                                                            Fill="{DynamicResource IgIconPurpleBrush}"
                                                            Stretch="Uniform" />
                                                        <TextBlock
                                                            x:Name="PART_TxtCurrentThemeStatus"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource IgDarkBrushE5E7EB}"
                                                            Text="当前：暗色" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!--  1.2 三栏可视化主题预览选择卡  -->
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

                                                <!--  卡片 A：跟随系统 (左暗右亮对半分屏预览)  -->
                                                <RadioButton
                                                    x:Name="PART_ModeSystem"
                                                    Grid.Column="0"
                                                    Classes="appearance-card"
                                                    Click="AppearanceMode_Click"
                                                    GroupName="AppearanceMode"
                                                    Tag="System">
                                                    <StackPanel Spacing="10">
                                                        <!--  迷你双拼桌面预览图  -->
                                                        <Border
                                                            Height="104"
                                                            BorderBrush="{DynamicResource IgDarkBrush16FFFFFF}"
                                                            BorderThickness="1"
                                                            ClipToBounds="True"
                                                            CornerRadius="8">
                                                            <Panel>
                                                                <Grid ColumnDefinitions="*,*">
                                                                    <!--  左半边：暗色工作室  -->
                                                                    <Border Grid.Column="0" Background="#14171D">
                                                                        <Grid RowDefinitions="20,*,16">
                                                                            <!--  模拟顶栏  -->
                                                                            <Border Grid.Row="0" Background="#1D212B" Padding="7,0">
                                                                                <StackPanel Orientation="Horizontal" Spacing="3.5" VerticalAlignment="Center">
                                                                                    <Ellipse Width="5" Height="5" Fill="#FF5F56" />
                                                                                    <Ellipse Width="5" Height="5" Fill="#FFBD2E" />
                                                                                    <Ellipse Width="5" Height="5" Fill="#27C93F" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <!--  模拟左半图片框  -->
                                                                            <Border Grid.Row="1" Margin="8,8,0,6" Background="#1E2533" BorderBrush="#2D374B" BorderThickness="1,1,0,1" CornerRadius="5,0,0,5" ClipToBounds="True">
                                                                                <Canvas>
                                                                                    <Path Fill="#38BDF8" Opacity="0.9" Data="M0,44 L18,22 L38,34 L62,14 L62,48 L0,48 Z" />
                                                                                    <Path Fill="#6366F1" Opacity="0.7" Data="M0,48 L22,30 L48,42 L62,36 L62,48 Z" />
                                                                                </Canvas>
                                                                            </Border>
                                                                            <!--  模拟左半底栏  -->
                                                                            <Border Grid.Row="2" Background="#1B1E26" Padding="8,0">
                                                                                <Border Height="3" Width="36" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="1.5" Background="#60A5FA" />
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                    <!--  右半边：亮色工作室  -->
                                                                    <Border Grid.Column="1" Background="#F1F5FA">
                                                                        <Grid RowDefinitions="20,*,16">
                                                                            <!--  模拟顶栏  -->
                                                                            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,7,0">
                                                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                                                    <Ellipse Width="5" Height="5" Fill="#0284C7" />
                                                                                    <Ellipse Width="5" Height="5" Fill="#059669" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <!--  模拟右半图片框  -->
                                                                            <Border Grid.Row="1" Margin="0,8,8,6" Background="#E0F2FE" BorderBrush="#CBD5E1" BorderThickness="0,1,1,1" CornerRadius="0,5,5,0" ClipToBounds="True">
                                                                                <Canvas>
                                                                                    <Ellipse Canvas.Left="24" Canvas.Top="8" Width="12" Height="12" Fill="#F59E0B" />
                                                                                    <Path Fill="#10B981" Opacity="0.9" Data="M0,26 L18,16 L46,34 L62,24 L62,48 L0,48 Z" />
                                                                                </Canvas>
                                                                            </Border>
                                                                            <!--  模拟右半底栏  -->
                                                                            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,0">
                                                                                <Border Height="3" Width="30" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="1.5" Background="#2563EB" />
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                </Grid>
                                                                <!--  中线光晕分割线 + Auto 小标  -->
                                                                <Border Width="1.5" HorizontalAlignment="Center" Background="#60A5FA" Opacity="0.85" />
                                                                <Border
                                                                    Margin="0,5,5,0"
                                                                    Padding="5,1.5"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Background="#CC1E293B"
                                                                    BorderBrush="#4060A5FA"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4">
                                                                    <TextBlock FontSize="8.5" FontWeight="Bold" Foreground="#93C5FD" Text="AUTO" />
                                                                </Border>
                                                            </Panel>
                                                        </Border>

                                                        <!--  标题说明 + 选中指示环  -->
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                            <Border Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center" Background="{DynamicResource IgIconBlueSoftBrush}" CornerRadius="7">
                                                                <Path Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource IgIconBlueBrush}" Stretch="Uniform" Data="M12 2a10 10 0 1 0 0 20V2Zm0 2.07A8 8 0 0 1 12 19.93V4.07Z" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                <TextBlock x:Name="PART_TxtModeSystemTitle" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource IgDarkBrushF3F4F6}" Text="跟随系统" />
                                                                <TextBlock x:Name="PART_TxtModeSystemDesc" FontSize="10.5" Foreground="{DynamicResource IgDarkBrush8B92A0}" Text="随 macOS 自动切换" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Border Classes="appearance-check-ring" Grid.Column="2" Width="18" Height="18" VerticalAlignment="Center" CornerRadius="9">
                                                                <Path Classes="appearance-check-mark" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FFFFFF" Stretch="Uniform" Data="M9.55 17.5a.75.75 0 0 1-.53-.22l-4.25-4.25a.75.75 0 0 1 1.06-1.06l3.72 3.72 8.22-8.22a.75.75 0 1 1 1.06 1.06l-8.75 8.75a.75.75 0 0 1-.53.22Z" />
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </RadioButton>

                                                <!--  卡片 B：暗色模式  -->
                                                <RadioButton
                                                    x:Name="PART_ModeDark"
                                                    Grid.Column="1"
                                                    Classes="appearance-card"
                                                    Click="AppearanceMode_Click"
                                                    GroupName="AppearanceMode"
                                                    Tag="Dark">
                                                    <StackPanel Spacing="10">
                                                        <!--  迷你暗色工作室预览图  -->
                                                        <Border
                                                            Height="104"
                                                            Background="#12151B"
                                                            BorderBrush="#2C3344"
                                                            BorderThickness="1"
                                                            ClipToBounds="True"
                                                            CornerRadius="8">
                                                            <Grid RowDefinitions="20,*,16">
                                                                <Border Grid.Row="0" Background="#1D212B" BorderBrush="#262C3A" BorderThickness="0,0,0,1" Padding="7,0">
                                                                    <Grid ColumnDefinitions="Auto,*">
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3.5" VerticalAlignment="Center">
                                                                            <Ellipse Width="5" Height="5" Fill="#FF5F56" />
                                                                            <Ellipse Width="5" Height="5" Fill="#FFBD2E" />
                                                                            <Ellipse Width="5" Height="5" Fill="#27C93F" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="3.5" VerticalAlignment="Center">
                                                                            <Ellipse Width="5" Height="5" Fill="#38BDF8" />
                                                                            <Ellipse Width="5" Height="5" Fill="#A78BFA" />
                                                                            <Ellipse Width="5" Height="5" Fill="#34D399" />
                                                                            <Ellipse Width="5" Height="5" Fill="#FBBF24" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                                <Border Grid.Row="1" Margin="10,8,10,6" Background="#19202E" BorderBrush="#2D374D" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                                                    <Canvas>
                                                                        <Ellipse Canvas.Left="88" Canvas.Top="7" Width="11" Height="11" Fill="#FBBF24" Opacity="0.9" />
                                                                        <Path Fill="#6366F1" Opacity="0.85" Data="M0,44 L24,20 L54,34 L84,15 L125,44 L125,48 L0,48 Z" />
                                                                        <Path Fill="#38BDF8" Opacity="0.72" Data="M0,48 L36,27 L72,40 L105,24 L125,48 Z" />
                                                                    </Canvas>
                                                                </Border>
                                                                <Border Grid.Row="2" Background="#171A22" BorderBrush="#242936" BorderThickness="0,1,0,0" Padding="8,0">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                        <Border Height="4" Width="18" CornerRadius="2" Background="#374151" />
                                                                        <Border Height="3" Width="54" VerticalAlignment="Center" CornerRadius="1.5" Background="#60A5FA" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!--  标题说明 + 选中指示环  -->
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                            <Border Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center" Background="{DynamicResource IgIconPurpleSoftBrush}" CornerRadius="7">
                                                                <Path Width="12.5" Height="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource IgIconPurpleBrush}" Stretch="Uniform" Data="{StaticResource IconWeatherMoon}" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                <TextBlock x:Name="PART_TxtModeDarkTitle" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource IgDarkBrushF3F4F6}" Text="暗色" />
                                                                <TextBlock x:Name="PART_TxtModeDarkDesc" FontSize="10.5" Foreground="{DynamicResource IgDarkBrush8B92A0}" Text="深邃低光专注视界" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Border Classes="appearance-check-ring" Grid.Column="2" Width="18" Height="18" VerticalAlignment="Center" CornerRadius="9">
                                                                <Path Classes="appearance-check-mark" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FFFFFF" Stretch="Uniform" Data="M9.55 17.5a.75.75 0 0 1-.53-.22l-4.25-4.25a.75.75 0 0 1 1.06-1.06l3.72 3.72 8.22-8.22a.75.75 0 1 1 1.06 1.06l-8.75 8.75a.75.75 0 0 1-.53.22Z" />
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </RadioButton>

                                                <!--  卡片 C：亮色模式  -->
                                                <RadioButton
                                                    x:Name="PART_ModeLight"
                                                    Grid.Column="2"
                                                    Classes="appearance-card"
                                                    Click="AppearanceMode_Click"
                                                    GroupName="AppearanceMode"
                                                    Tag="Light">
                                                    <StackPanel Spacing="10">
                                                        <!--  迷你亮色工作室预览图  -->
                                                        <Border
                                                            Height="104"
                                                            Background="#EEF3F9"
                                                            BorderBrush="#CBD5E1"
                                                            BorderThickness="1"
                                                            ClipToBounds="True"
                                                            CornerRadius="8">
                                                            <Grid RowDefinitions="20,*,16">
                                                                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="7,0">
                                                                    <Grid ColumnDefinitions="Auto,*">
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3.5" VerticalAlignment="Center">
                                                                            <Ellipse Width="5" Height="5" Fill="#FF5F56" />
                                                                            <Ellipse Width="5" Height="5" Fill="#FFBD2E" />
                                                                            <Ellipse Width="5" Height="5" Fill="#27C93F" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="3.5" VerticalAlignment="Center">
                                                                            <Ellipse Width="5" Height="5" Fill="#0284C7" />
                                                                            <Ellipse Width="5" Height="5" Fill="#7C3AED" />
                                                                            <Ellipse Width="5" Height="5" Fill="#059669" />
                                                                            <Ellipse Width="5" Height="5" Fill="#D97706" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                                <Border Grid.Row="1" Margin="10,8,10,6" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                                                    <Canvas>
                                                                        <Ellipse Canvas.Left="88" Canvas.Top="7" Width="12" Height="12" Fill="#F59E0B" />
                                                                        <Path Fill="#0EA5E9" Opacity="0.85" Data="M0,44 L28,22 L58,34 L90,17 L125,44 L125,48 L0,48 Z" />
                                                                        <Path Fill="#10B981" Opacity="0.9" Data="M0,48 L40,28 L76,39 L108,26 L125,48 Z" />
                                                                    </Canvas>
                                                                </Border>
                                                                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,0">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                        <Border Height="4" Width="18" CornerRadius="2" Background="#CBD5E1" />
                                                                        <Border Height="3" Width="54" VerticalAlignment="Center" CornerRadius="1.5" Background="#2563EB" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!--  标题说明 + 选中指示环  -->
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                            <Border Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center" Background="{DynamicResource IgIconAmberSoftBrush}" CornerRadius="7">
                                                                <Path Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource IgIconAmberBrush}" Stretch="Uniform" Data="{StaticResource IconWeatherSunny}" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                <TextBlock x:Name="PART_TxtModeLightTitle" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource IgDarkBrushF3F4F6}" Text="亮色" />
                                                                <TextBlock x:Name="PART_TxtModeLightDesc" FontSize="10.5" Foreground="{DynamicResource IgDarkBrush8B92A0}" Text="清爽明亮日间工作台" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Border Classes="appearance-check-ring" Grid.Column="2" Width="18" Height="18" VerticalAlignment="Center" CornerRadius="9">
                                                                <Path Classes="appearance-check-mark" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FFFFFF" Stretch="Uniform" Data="M9.55 17.5a.75.75 0 0 1-.53-.22l-4.25-4.25a.75.75 0 0 1 1.06-1.06l3.72 3.72 8.22-8.22a.75.75 0 1 1 1.06 1.06l-8.75 8.75a.75.75 0 0 1-.53.22Z" />
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </RadioButton>

                                            </Grid>

                                            <!--  1.3 实时色彩自适应状态与图标色板预览卡  -->
                                            <Border
                                                Padding="14,12"
                                                Background="{DynamicResource IgDarkBrush181A20}"
                                                BorderBrush="{DynamicResource IgDarkBrush12FFFFFF}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <Path
                                                                Width="13"
                                                                Height="13"
                                                                VerticalAlignment="Center"
                                                                Data="{StaticResource IconToolColorPicker}"
                                                                Fill="{DynamicResource IgIconCyanBrush}"
                                                                Stretch="Uniform" />
                                                            <TextBlock
                                                                x:Name="PART_AppearancePaletteTitle"
                                                                FontSize="12.5"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource IgDarkBrushE5E7EB}"
                                                                Text="双主题语义图标自动适配" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            x:Name="PART_AppearancePaletteDesc"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource IgDarkBrush8B92A0}"
                                                            Text="已为当前主题自动调整工具栏、主菜单、右键菜单及工作台面板图标的色彩与对比度。"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <!--  语义图标调色板实时预览组  -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Border Width="26" Height="26" Background="{DynamicResource IgIconBlueSoftBrush}" CornerRadius="7" ToolTip.Tip="文件与基础视图">
                                                            <Path Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource IconSave}" Fill="{DynamicResource IgIconBlueBrush}" Stretch="Uniform" />
                                                        </Border>
                                                        <Border Width="26" Height="26" Background="{DynamicResource IgIconCyanSoftBrush}" CornerRadius="7" ToolTip.Tip="画布与缩放导航">
                                                            <Path Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource IconInfo}" Fill="{DynamicResource IgIconCyanBrush}" Stretch="Uniform" />
                                                        </Border>
                                                        <Border Width="26" Height="26" Background="{DynamicResource IgIconEmeraldSoftBrush}" CornerRadius="7" ToolTip.Tip="裁剪与画面适配">
                                                            <Path Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource IconCrop}" Fill="{DynamicResource IgIconEmeraldBrush}" Stretch="Uniform" />
                                                        </Border>
                                                        <Border Width="26" Height="26" Background="{DynamicResource IgIconAmberSoftBrush}" CornerRadius="7" ToolTip.Tip="文件夹与重置操作">
                                                            <Path Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource IgIconAmberBrush}" Stretch="Uniform" />
                                                        </Border>
                                                        <Border Width="26" Height="26" Background="{DynamicResource IgIconPurpleSoftBrush}" CornerRadius="7" ToolTip.Tip="反转与窗口扩展">
                                                            <Path Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource IconToolProjector}" Fill="{DynamicResource IgIconPurpleBrush}" Stretch="Uniform" />
                                                        </Border>
                                                        <Border Width="26" Height="26" Background="{DynamicResource IgIconRoseSoftBrush}" CornerRadius="7" ToolTip.Tip="删除与警戒动作">
                                                            <Path Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource IconToolHdrToneMapper}" Fill="{DynamicResource IgIconRoseBrush}" Stretch="Uniform" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                        </StackPanel>
                                    </ScrollViewer>
                                    <ScrollViewer
                                        x:Name="PART_PageTheme"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="22,16,20,20" Spacing="14">

                                            <!--  管理员锁定提示  -->
                                            <Border
                                                x:Name="PART_ThemeLockWarning"
                                                Padding="11,8"
                                                Background="{DynamicResource IgDarkBrush1CF59E0B}"
                                                BorderBrush="{DynamicResource IgDarkBrush36F59E0B}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                IsVisible="False">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Path
                                                        Width="13"
                                                        Height="13"
                                                        VerticalAlignment="Center"
                                                        Data="{StaticResource IconInfo}"
                                                        Fill="{DynamicResource IgDarkBrushFBBF24}"
                                                        Stretch="Uniform" />
                                                    <TextBlock
                                                        x:Name="PART_ThemeLockWarningText"
                                                        VerticalAlignment="Center"
                                                        FontSize="11.5"
                                                        Foreground="{DynamicResource IgDarkBrushFCD34D}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!--  1.1 当前主题槽位双栏概览卡  -->
                                            <Border
                                                Padding="14,12"
                                                Background="{DynamicResource IgDarkBrush181A20}"
                                                BorderBrush="{DynamicResource IgDarkBrush12FFFFFF}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <Grid ColumnDefinitions="*,Auto,*">
                                                    <!--  深色模式槽  -->
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Path
                                                                Width="11.5"
                                                                Height="11.5"
                                                                VerticalAlignment="Center"
                                                                Data="{StaticResource IconWeatherMoon}"
                                                                Fill="{DynamicResource IgDarkBrush8B92A0}"
                                                                Stretch="Uniform" />
                                                            <TextBlock
                                                                x:Name="PART_LblDarkSlotTitle"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource IgDarkBrush8B92A0}" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            x:Name="PART_DarkSlotValue"
                                                            FontSize="13.5"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource IgDarkBrushF3F4F6}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Border
                                                        Grid.Column="1"
                                                        Width="1"
                                                        Margin="18,2"
                                                        Background="{DynamicResource IgDarkBrush14FFFFFF}" />

                                                    <!--  浅色模式槽 (当前主生效槽位)  -->
                                                    <StackPanel Grid.Column="2" Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Path
                                                                Width="12"
                                                                Height="12"
                                                                VerticalAlignment="Center"
                                                                Data="{StaticResource IconWeatherSunny}"
                                                                Fill="{DynamicResource IgDarkBrushFBBF24}"
                                                                Stretch="Uniform" />
                                                            <TextBlock
                                                                x:Name="PART_LblLightSlotTitle"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource IgDarkBrush8B92A0}" />
                                                            <Border
                                                                x:Name="PART_LightSlotActiveBadge"
                                                                Padding="5,1"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource IgDarkBrush1C10B981}"
                                                                BorderBrush="{DynamicResource IgDarkBrush3610B981}"
                                                                BorderThickness="1"
                                                                CornerRadius="4">
                                                                <TextBlock
                                                                    x:Name="PART_TxtActiveSlot"
                                                                    FontSize="9.5"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource IgDarkBrush34D399}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock
                                                            x:Name="PART_LightSlotValue"
                                                            FontSize="13.5"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource IgDarkBrushF3F4F6}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!--  1.2 查看器背景色 (实时预览画布色彩 + HEX 精确控制)  -->
                                            <Border
                                                Padding="14,12"
                                                Background="{DynamicResource IgDarkBrush181A20}"
                                                BorderBrush="{DynamicResource IgDarkBrush12FFFFFF}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Spacing="1">
                                                            <TextBlock
                                                                x:Name="PART_LblBgColorTitle"
                                                                FontSize="12.5"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource IgDarkBrushE5E7EB}" />
                                                            <TextBlock
                                                                x:Name="PART_LblBgColorDesc"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource IgDarkBrush7C8391}" />
                                                        </StackPanel>

                                                        <Button
                                                            x:Name="PART_BtnBgReset"
                                                            Classes="link overlay-micro-link"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Click="ResetBgColor_Click" />
                                                    </Grid>

                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                        <!--  预设色块矩阵  -->
                                                        <StackPanel
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal"
                                                            Spacing="6">
                                                            <Button
                                                                x:Name="PART_SwatchDefault"
                                                                Classes="link bg-swatch-btn"
                                                                Click="PresetBgSwatch_Click"
                                                                Tag="#00000000">
                                                                <Border CornerRadius="4" ClipToBounds="True">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                            <GradientStop Color="{DynamicResource IgDarkColor2C2E34}" Offset="0.0" />
                                                                            <GradientStop Color="{DynamicResource IgDarkColor191B20}" Offset="1.0" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                    <Path
                                                                        Width="12"
                                                                        Height="12"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Data="M 1,11 L 11,1"
                                                                        Stroke="{DynamicResource IgDarkBrush60A5FA}"
                                                                        StrokeThickness="1.4" />
                                                                </Border>
                                                            </Button>
                                                            <Button
                                                                x:Name="PART_SwatchBlack"
                                                                Classes="link bg-swatch-btn"
                                                                Click="PresetBgSwatch_Click"
                                                                Tag="#FF0B0D10">
                                                                <Border Background="{DynamicResource IgDarkBrush0B0D10}" CornerRadius="4" />
                                                            </Button>
                                                            <Button
                                                                x:Name="PART_SwatchSlate"
                                                                Classes="link bg-swatch-btn"
                                                                Click="PresetBgSwatch_Click"
                                                                Tag="#FF1E2026">
                                                                <Border Background="{DynamicResource IgDarkBrush1E2026}" CornerRadius="4" />
                                                            </Button>
                                                            <Button
                                                                x:Name="PART_SwatchNeutral"
                                                                Classes="link bg-swatch-btn"
                                                                Click="PresetBgSwatch_Click"
                                                                Tag="#FF4A4F59">
                                                                <Border Background="{DynamicResource IgDarkBrush4A4F59}" CornerRadius="4" />
                                                            </Button>
                                                            <Button
                                                                x:Name="PART_SwatchLightGray"
                                                                Classes="link bg-swatch-btn"
                                                                Click="PresetBgSwatch_Click"
                                                                Tag="#FFE5E7EB">
                                                                <Border Background="{DynamicResource IgDarkBrushE5E7EB}" CornerRadius="4" />
                                                            </Button>
                                                            <Button
                                                                x:Name="PART_SwatchWhite"
                                                                Classes="link bg-swatch-btn"
                                                                Click="PresetBgSwatch_Click"
                                                                Tag="#FFFFFFFF">
                                                                <Border Background="{DynamicResource IgDarkBrushFFFFFF}" CornerRadius="4" />
                                                            </Button>
                                                        </StackPanel>

                                                        <!--  实时预览 + HEX 色码输入凹槽  -->
                                                        <Border
                                                            x:Name="PART_BgHexBox"
                                                            Classes="overlay-input-box"
                                                            Grid.Column="2"
                                                            Width="148"
                                                            Height="30">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <Border
                                                                    x:Name="PART_BgPreviewDot"
                                                                    Grid.Column="0"
                                                                    Width="16"
                                                                    Height="16"
                                                                    Margin="8,0,2,0"
                                                                    VerticalAlignment="Center"
                                                                    BorderBrush="{DynamicResource IgDarkBrush2CFFFFFF}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4" />
                                                                <TextBox
                                                                    x:Name="PART_BgHexInput"
                                                                    Classes="overlay-textbox"
                                                                    Grid.Column="1"
                                                                    FontFamily="Consolas, SF Mono, Menlo, monospace"
                                                                    FontSize="12"
                                                                    Padding="4,0,8,0"
                                                                    TextChanged="BgHexInput_TextChanged" />
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!--  1.3 窗口背景材质 (Windows 11+ 专属，macOS 自动隐藏)  -->
                                            <Border
                                                x:Name="PART_BackdropGroup"
                                                Padding="14,11"
                                                Background="{DynamicResource IgDarkBrush181A20}"
                                                BorderBrush="{DynamicResource IgDarkBrush12FFFFFF}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                IsVisible="False">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <TextBlock
                                                        x:Name="PART_LblBackdropTitle"
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource IgDarkBrushE5E7EB}" />
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="3"
                                                        Background="{DynamicResource IgDarkBrush15171C}"
                                                        BorderBrush="{DynamicResource IgDarkBrush14FFFFFF}"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                                            <Button x:Name="PART_BackdropMica" Classes="link overlay-filter-pill" Click="BackdropPill_Click" Content="Mica" Tag="Mica" />
                                                            <Button x:Name="PART_BackdropMicaAlt" Classes="link overlay-filter-pill" Click="BackdropPill_Click" Content="Mica Alt" Tag="MicaAlt" />
                                                            <Button x:Name="PART_BackdropAcrylic" Classes="link overlay-filter-pill" Click="BackdropPill_Click" Content="Acrylic" Tag="Acrylic" />
                                                            <Button x:Name="PART_BackdropNone" Classes="link overlay-filter-pill" Click="BackdropPill_Click" Content="None" Tag="None" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!--  1.4 已安装主题包列表头 + 卡片集合  -->
                                            <Grid ColumnDefinitions="*,Auto" Margin="2,2,0,0">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock
                                                        x:Name="PART_LblThemePacksTitle"
                                                        VerticalAlignment="Center"
                                                        FontSize="12.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource IgDarkBrushE5E7EB}" />
                                                    <Border
                                                        Padding="7,1.5"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource IgDarkBrush12FFFFFF}"
                                                        CornerRadius="8">
                                                        <TextBlock
                                                            x:Name="PART_ThemePacksCount"
                                                            FontSize="10.5"
                                                            Foreground="{DynamicResource IgDarkBrush9CA3AF}" />
                                                    </Border>
                                                </StackPanel>

                                                <Button
                                                    x:Name="PART_BtnGetMoreThemes"
                                                    Classes="link overlay-micro-link"
                                                    Grid.Column="1"
                                                    Click="GetMoreThemes_Click" />
                                            </Grid>

                                            <StackPanel
                                                x:Name="PART_ThemeCardsList"
                                                Spacing="8" />

                                            <TextBlock
                                                x:Name="PART_ThemeEmptyText"
                                                Margin="0,14"
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource IgDarkBrush6B7280}"
                                                IsVisible="False" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!--  ================================================  -->
                                    <!--  PAGE 2: 关联格式 (PART_PageAssociations)          -->
                                    <!--  ================================================  -->
                                    <Grid
                                        x:Name="PART_PageAssociations"
                                        Margin="22,14,20,14"
                                        IsVisible="False"
                                        RowDefinitions="Auto,Auto,Auto,Auto,*">

                                        <!--  2.0 管理员锁定警告条  -->
                                        <Border
                                            x:Name="PART_LockWarning"
                                            Grid.Row="0"
                                            Margin="0,0,0,10"
                                            Padding="11,8"
                                            Background="{DynamicResource IgDarkBrush1CF59E0B}"
                                            BorderBrush="{DynamicResource IgDarkBrush36F59E0B}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            IsVisible="False">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path
                                                    Width="13"
                                                    Height="13"
                                                    VerticalAlignment="Center"
                                                    Data="{StaticResource IconInfo}"
                                                    Fill="{DynamicResource IgDarkBrushFBBF24}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    x:Name="PART_LockWarningText"
                                                    VerticalAlignment="Center"
                                                    FontSize="11.5"
                                                    Foreground="{DynamicResource IgDarkBrushFCD34D}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!--  2.1 平台系统集成紧凑卡片 (Windows / Linux AppImage，macOS 自动隐藏)  -->
                                        <Border
                                            x:Name="PART_SysIntegrationBar"
                                            Grid.Row="1"
                                            Margin="0,0,0,10"
                                            Padding="12,9"
                                            Background="{DynamicResource IgDarkBrush181A20}"
                                            BorderBrush="{DynamicResource IgDarkBrush12FFFFFF}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            IsVisible="False">
                                            <StackPanel Spacing="8">
                                                <Grid
                                                    x:Name="PART_WinIntegrationRow"
                                                    ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="12"
                                                    IsVisible="False">
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock
                                                            x:Name="PART_WinDefaultTitle"
                                                            FontSize="12.5"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource IgDarkBrushE5E7EB}" />
                                                        <TextBlock
                                                            x:Name="PART_WinDefaultScope"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource IgDarkBrush8B92A0}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <WrapPanel
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                        <Button
                                                            x:Name="PART_BtnWinRegister"
                                                            Classes="link overlay-secondary-btn"
                                                            Height="26"
                                                            Margin="0,2,6,2"
                                                            Padding="10,0"
                                                            Click="WinRegister_Click" />
                                                        <Button
                                                            x:Name="PART_BtnWinUnregister"
                                                            Classes="link overlay-secondary-btn"
                                                            Height="26"
                                                            Margin="0,2,6,2"
                                                            Padding="10,0"
                                                            Click="WinUnregister_Click" />
                                                        <Button
                                                            x:Name="PART_BtnWinDefaultApps"
                                                            Classes="link overlay-micro-link"
                                                            Margin="0,2,2,2"
                                                            Click="WinOpenDefaultApps_Click" />
                                                        <Button
                                                            x:Name="PART_BtnWinExtIcons"
                                                            Classes="link overlay-micro-link"
                                                            Margin="0,2,0,2"
                                                            Click="WinOpenExtIcons_Click" />
                                                    </WrapPanel>
                                                </Grid>

                                                <Grid
                                                    x:Name="PART_LinuxAppMenuRow"
                                                    ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="12"
                                                    IsVisible="False">
                                                    <TextBlock
                                                        x:Name="PART_LinuxAppMenuTitle"
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource IgDarkBrushE5E7EB}" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="6">
                                                        <Button
                                                            x:Name="PART_BtnLinuxRegister"
                                                            Classes="link overlay-secondary-btn"
                                                            Height="26"
                                                            Padding="10,0"
                                                            Click="LinuxRegister_Click" />
                                                        <Button
                                                            x:Name="PART_BtnLinuxUnregister"
                                                            Classes="link overlay-secondary-btn"
                                                            Height="26"
                                                            Padding="10,0"
                                                            Click="LinuxUnregister_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!--  2.2 搜索过滤 + 分段筛选 + 新增格式工具条  -->
                                        <Grid
                                            Grid.Row="2"
                                            Margin="0,0,0,10"
                                            ColumnDefinitions="*,Auto,Auto"
                                            ColumnSpacing="8">
                                            <Border Classes="overlay-input-box" Grid.Column="0" Height="32">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Path
                                                        Grid.Column="0"
                                                        Width="12.5"
                                                        Height="12.5"
                                                        Margin="10,0,2,0"
                                                        VerticalAlignment="Center"
                                                        Data="{StaticResource IconSearch}"
                                                        Fill="{DynamicResource IgIconCyanBrush}"
                                                        Stretch="Uniform" />
                                                    <TextBox
                                                        x:Name="PART_SearchBox"
                                                        Classes="overlay-textbox"
                                                        Grid.Column="1"
                                                        KeyDown="SearchBox_KeyDown"
                                                        TextChanged="SearchBox_TextChanged" />
                                                    <Button
                                                        x:Name="PART_BtnClearSearch"
                                                        Classes="link overlay-icon-btn"
                                                        Grid.Column="2"
                                                        Width="22"
                                                        Height="22"
                                                        Margin="0,0,4,0"
                                                        Click="ClearSearch_Click"
                                                        IsVisible="False">
                                                        <Path
                                                            Width="8.5"
                                                            Height="8.5"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Data="{StaticResource IconClose}"
                                                            Fill="{DynamicResource IgDarkBrush8E95A2}"
                                                            Stretch="Uniform" />
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <Border
                                                Grid.Column="1"
                                                Padding="3"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource IgDarkBrush15171C}"
                                                BorderBrush="{DynamicResource IgDarkBrush14FFFFFF}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <Button
                                                        x:Name="PART_FilterAll"
                                                        Classes="link overlay-filter-pill active"
                                                        Click="FilterPill_Click"
                                                        Tag="all" />
                                                    <Button
                                                        x:Name="PART_FilterCustom"
                                                        Classes="link overlay-filter-pill"
                                                        Click="FilterPill_Click"
                                                        Tag="custom" />
                                                    <Button
                                                        x:Name="PART_FilterPlugin"
                                                        Classes="link overlay-filter-pill"
                                                        Click="FilterPill_Click"
                                                        IsVisible="False"
                                                        Tag="plugin" />
                                                </StackPanel>
                                            </Border>

                                            <Button
                                                x:Name="PART_BtnToggleAdd"
                                                Classes="link overlay-soft-accent-btn"
                                                Grid.Column="2"
                                                Height="32"
                                                Click="ToggleAddBar_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Path
                                                        Width="10.5"
                                                        Height="10.5"
                                                        VerticalAlignment="Center"
                                                        Data="{StaticResource IconAdd}"
                                                        Fill="{DynamicResource IgDarkBrush93C5FD}"
                                                        Stretch="Uniform" />
                                                    <TextBlock
                                                        x:Name="PART_TxtAddFormat"
                                                        VerticalAlignment="Center"
                                                        Text="添加格式" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!--  2.3 可折叠内联添加新格式输入栏  -->
                                        <Border
                                            x:Name="PART_AddBar"
                                            Grid.Row="3"
                                            Margin="0,0,0,10"
                                            Padding="11,9"
                                            Background="{DynamicResource IgDarkBrush191D25}"
                                            BorderBrush="{DynamicResource IgDarkBrush3D3B82F6}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            IsVisible="False">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <Border
                                                        x:Name="PART_AddInputBox"
                                                        Classes="overlay-input-box"
                                                        Grid.Column="0"
                                                        Height="30">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Margin="10,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontFamily="Consolas, SF Mono, Menlo, monospace"
                                                                FontSize="12"
                                                                Foreground="{DynamicResource IgDarkBrush60A5FA}"
                                                                Text="." />
                                                            <TextBox
                                                                x:Name="PART_AddInput"
                                                                Classes="overlay-textbox"
                                                                Grid.Column="1"
                                                                Padding="3,0,8,0"
                                                                KeyDown="AddInput_KeyDown"
                                                                TextChanged="AddInput_TextChanged" />
                                                        </Grid>
                                                    </Border>

                                                    <Button
                                                        x:Name="PART_BtnConfirmAdd"
                                                        Classes="link overlay-primary-btn"
                                                        Grid.Column="1"
                                                        MinWidth="66"
                                                        Height="30"
                                                        Padding="14,0"
                                                        Click="ConfirmAdd_Click"
                                                        Content="加入" />

                                                    <Button
                                                        x:Name="PART_BtnCancelAdd"
                                                        Classes="link overlay-secondary-btn"
                                                        Grid.Column="2"
                                                        Height="30"
                                                        Padding="11,0"
                                                        Click="CancelAdd_Click"
                                                        Content="取消" />
                                                </Grid>

                                                <TextBlock
                                                    x:Name="PART_AddHintText"
                                                    Margin="2,0,0,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource IgDarkBrush8B92A0}" />
                                            </StackPanel>
                                        </Border>

                                        <!--  2.4 格式清单主体容器  -->
                                        <Border
                                            Grid.Row="4"
                                            MinHeight="160"
                                            Background="{DynamicResource IgDarkBrush17191E}"
                                            BorderBrush="{DynamicResource IgDarkBrush12FFFFFF}"
                                            BorderThickness="1"
                                            ClipToBounds="True"
                                            CornerRadius="10">
                                            <Grid RowDefinitions="Auto,*">
                                                <Border
                                                    Grid.Row="0"
                                                    Padding="14,8"
                                                    Background="{DynamicResource IgDarkBrush1D2027}"
                                                    BorderBrush="{DynamicResource IgDarkBrush10FFFFFF}"
                                                    BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="36, 130, *, *, 40">
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource IgDarkBrush747B89}"
                                                            Text="#" />
                                                        <TextBlock
                                                            x:Name="PART_ColExtHeader"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource IgDarkBrush747B89}" />
                                                        <TextBlock
                                                            x:Name="PART_ColDecoderHeader"
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource IgDarkBrush747B89}" />
                                                        <TextBlock
                                                            x:Name="PART_ColEncoderHeader"
                                                            Grid.Column="3"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource IgDarkBrush747B89}" />
                                                        <TextBlock
                                                            x:Name="PART_ColActionHeader"
                                                            Grid.Column="4"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource IgDarkBrush747B89}" />
                                                    </Grid>
                                                </Border>

                                                <ScrollViewer
                                                    x:Name="PART_FormatsScroll"
                                                    Grid.Row="1"
                                                    HorizontalScrollBarVisibility="Disabled"
                                                    VerticalScrollBarVisibility="Auto">
                                                    <Panel>
                                                        <ItemsControl x:Name="PART_FormatsList">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="windows:SettingsFormatRowModel">
                                                                    <Border
                                                                        Classes="format-row"
                                                                        Classes.highlighted="{CompiledBinding IsHighlighted}">
                                                                        <Grid ColumnDefinitions="36, 130, *, *, 40">
                                                                            <TextBlock
                                                                                Grid.Column="0"
                                                                                VerticalAlignment="Center"
                                                                                FontFamily="Consolas, SF Mono, Menlo, monospace"
                                                                                FontSize="11"
                                                                                Foreground="{DynamicResource IgDarkBrush636B78}"
                                                                                Text="{CompiledBinding IndexText}" />

                                                                            <StackPanel
                                                                                Grid.Column="1"
                                                                                Margin="0,0,8,0"
                                                                                VerticalAlignment="Center"
                                                                                Orientation="Horizontal"
                                                                                Spacing="5">
                                                                                <Border
                                                                                    Padding="6,2"
                                                                                    VerticalAlignment="Center"
                                                                                    Background="{DynamicResource IgDarkBrush232731}"
                                                                                    BorderBrush="{DynamicResource IgDarkBrush14FFFFFF}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="5">
                                                                                    <TextBlock
                                                                                        FontFamily="Consolas, SF Mono, Menlo, monospace"
                                                                                        FontSize="11.5"
                                                                                        FontWeight="SemiBold"
                                                                                        Foreground="{DynamicResource IgDarkBrushF3F4F6}"
                                                                                        Text="{CompiledBinding Extension}" />
                                                                                </Border>
                                                                                <Border
                                                                                    Padding="5,1"
                                                                                    VerticalAlignment="Center"
                                                                                    Background="{DynamicResource IgDarkBrush1E3B82F6}"
                                                                                    BorderBrush="{DynamicResource IgDarkBrush363B82F6}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="4"
                                                                                    IsVisible="{CompiledBinding IsCustom}">
                                                                                    <TextBlock
                                                                                        FontSize="9.5"
                                                                                        FontWeight="SemiBold"
                                                                                        Foreground="{DynamicResource IgDarkBrush93C5FD}"
                                                                                        Text="{CompiledBinding BadgeText}" />
                                                                                </Border>
                                                                                <Border
                                                                                    Padding="5,1"
                                                                                    VerticalAlignment="Center"
                                                                                    Background="{DynamicResource IgDarkBrush248B5CF6}"
                                                                                    BorderBrush="{DynamicResource IgDarkBrush408B5CF6}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="4"
                                                                                    IsVisible="{CompiledBinding IsPlugin}">
                                                                                    <TextBlock
                                                                                        FontSize="9.5"
                                                                                        FontWeight="SemiBold"
                                                                                        Foreground="{DynamicResource IgDarkBrushC4B5FD}"
                                                                                        Text="{CompiledBinding BadgeText}" />
                                                                                </Border>
                                                                            </StackPanel>

                                                                            <TextBlock
                                                                                Grid.Column="2"
                                                                                Margin="0,0,8,0"
                                                                                VerticalAlignment="Center"
                                                                                FontSize="12"
                                                                                Foreground="{CompiledBinding DecoderForeground}"
                                                                                Text="{CompiledBinding DecoderText}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                ToolTip.Tip="{CompiledBinding DecoderText}" />

                                                                            <TextBlock
                                                                                Grid.Column="3"
                                                                                Margin="0,0,8,0"
                                                                                VerticalAlignment="Center"
                                                                                FontSize="12"
                                                                                Foreground="{CompiledBinding EncoderForeground}"
                                                                                Text="{CompiledBinding EncoderText}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                ToolTip.Tip="{CompiledBinding EncoderText}" />

                                                                            <Panel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                                <Button
                                                                                    Classes="link format-delete-btn"
                                                                                    Click="DeleteFormatRow_Click"
                                                                                    IsVisible="{CompiledBinding CanDelete}"
                                                                                    Tag="{CompiledBinding Extension}"
                                                                                    ToolTip.Tip="{CompiledBinding DeleteTooltip}">
                                                                                    <Path
                                                                                        Width="11.5"
                                                                                        Height="11.5"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"
                                                                                        Data="M6.442 2.5a2 2 0 0 1 2-2h3.046a2 2 0 0 1 2 2v.314c0 .036-.003.07-.01.105h4.952a.5.5 0 1 1 0 1h-.764l-1.558 13.507a2.5 2.5 0 0 1-2.484 2.214H6.306a2.5 2.5 0 0 1-2.484-2.214L2.264 3.92H1.5a.5.5 0 0 1 0-1h4.953a.502.502 0 0 1-.011-.105V2.5Zm.989.419h5.068a.501.501 0 0 1-.01-.105V2.5a1 1 0 0 0-1-1H8.441a1 1 0 0 0-1 1v.314c0 .036-.004.07-.011.105Zm-4.16 1L4.815 17.31a1.5 1.5 0 0 0 1.49 1.329h7.318a1.5 1.5 0 0 0 1.49-1.329L16.66 3.92H3.27Zm5.38 3.337a.5.5 0 1 0-1 0v7.256a.5.5 0 0 0 1 0V7.256Zm3.128-.5a.5.5 0 0 1 .5.5v7.256a.5.5 0 0 1-1 0V7.256a.5.5 0 0 1 .5-.5Z"
                                                                                        Stretch="Uniform" />
                                                                                </Button>

                                                                                <Border
                                                                                    Width="24"
                                                                                    Height="24"
                                                                                    Background="Transparent"
                                                                                    IsVisible="{CompiledBinding IsReadOnlyIndicatorVisible}"
                                                                                    ToolTip.Tip="{CompiledBinding ReadOnlyTooltip}">
                                                                                    <Path
                                                                                        Width="11"
                                                                                        Height="11"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"
                                                                                        Data="M12 2a4 4 0 0 0-4 4v2H6.5A1.5 1.5 0 0 0 5 9.5v8A1.5 1.5 0 0 0 6.5 19h11a1.5 1.5 0 0 0 1.5-1.5v-8A1.5 1.5 0 0 0 17.5 8H16V6a4 4 0 0 0-4-4Zm-2.5 4a2.5 2.5 0 0 1 5 0v2h-5V6Z"
                                                                                        Fill="{DynamicResource IgDarkBrush525866}"
                                                                                        Stretch="Uniform" />
                                                                                </Border>
                                                                            </Panel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <StackPanel
                                                            x:Name="PART_EmptyState"
                                                            Margin="20,36"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            IsVisible="False"
                                                            Spacing="6">
                                                            <TextBlock
                                                                x:Name="PART_EmptyTitle"
                                                                HorizontalAlignment="Center"
                                                                FontSize="13"
                                                                FontWeight="Medium"
                                                                Foreground="{DynamicResource IgDarkBrush9CA3AF}" />
                                                            <TextBlock
                                                                x:Name="PART_EmptyDesc"
                                                                HorizontalAlignment="Center"
                                                                FontSize="11.5"
                                                                Foreground="{DynamicResource IgDarkBrush6B7280}" />
                                                        </StackPanel>
                                                    </Panel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                </Panel>
                            </Grid>
                        </Grid>

                        <!--  ======================================================  -->
                        <!--  UNIFIED FOOTER (通栏沉稳底座：重置当前页 | 未保存提示 | 取消/保存)  -->
                        <!--  ======================================================  -->
                        <Border
                            Grid.Row="1"
                            Padding="20,11"
                            Background="{DynamicResource IgDarkBrush1C1E23}"
                            BorderBrush="{DynamicResource IgDarkBrush10FFFFFF}"
                            BorderThickness="0,1,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <Button
                                        x:Name="PART_BtnResetDefaults"
                                        Classes="link overlay-secondary-btn"
                                        Click="ResetCurrentPageDefaults_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path
                                                Width="11.5"
                                                Height="11.5"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource IconReset}"
                                                Fill="{DynamicResource IgIconAmberBrush}"
                                                Stretch="Uniform" />
                                            <TextBlock x:Name="PART_TxtResetDefaults" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <StackPanel
                                        x:Name="PART_DirtyBanner"
                                        VerticalAlignment="Center"
                                        IsVisible="False"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Fill="{DynamicResource IgDarkBrushFBBF24}" />
                                        <TextBlock
                                            x:Name="PART_DirtyText"
                                            VerticalAlignment="Center"
                                            FontSize="11.5"
                                            Foreground="{DynamicResource IgDarkBrushFCD34D}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="PART_BtnCancel"
                                        Classes="link overlay-secondary-btn"
                                        MinWidth="74"
                                        Click="Cancel_Click" />
                                    <Button
                                        x:Name="PART_BtnSave"
                                        Classes="link overlay-primary-btn"
                                        Click="Save_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>

                    <!--  ======================================================  -->
                    <!--  INTERNAL THEME PREVIEW OVERLAY (点击卡片缩略图全卡放大预览)  -->
                    <!--  ======================================================  -->
                    <Grid
                        x:Name="PART_ThemePreviewOverlay"
                        Background="{DynamicResource IgDarkBrushCC101216}"
                        Cursor="Hand"
                        IsVisible="False"
                        PointerPressed="CloseThemePreview_PointerPressed"
                        ZIndex="50">
                        <Border
                            Margin="28"
                            Padding="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource IgDarkBrush242730}"
                            BorderBrush="{DynamicResource IgDarkBrush2CFFFFFF}"
                            BorderThickness="1"
                            BoxShadow="0 20 56 0 #D0000000"
                            CornerRadius="12">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" Margin="4,0,4,10" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="PART_PreviewThemeTitle"
                                            FontSize="13.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource IgDarkBrushF3F4F6}" />
                                        <TextBlock
                                            x:Name="PART_PreviewThemeTip"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource IgDarkBrush8B92A0}" />
                                    </StackPanel>
                                    <Button
                                        Classes="link overlay-icon-btn"
                                        Grid.Column="1"
                                        Width="24"
                                        Height="24"
                                        Click="CloseThemePreview_Click">
                                        <Path
                                            Width="9"
                                            Height="9"
                                            Data="{StaticResource IconClose}"
                                            Fill="{DynamicResource IgDarkBrushD1D5DB}"
                                            Stretch="Uniform" />
                                    </Button>
                                </Grid>
                                <Border
                                    Grid.Row="1"
                                    ClipToBounds="True"
                                    CornerRadius="8">
                                    <Image
                                        x:Name="PART_PreviewLargeImage"
                                        MaxWidth="720"
                                        MaxHeight="440"
                                        Stretch="Uniform" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                </Panel>
            </Border>
        </ThemeVariantScope>
    </Grid>
</UserControl>
