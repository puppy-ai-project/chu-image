<uiw:PhWindow
    x:Class="ImageGlass.Common.Windows.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cm="using:ImageGlass.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uiw="using:ImageGlass.UI.Windowing"
    xmlns:vm="using:ImageGlass.ViewModels"
    xmlns:wv="using:ImageGlass.Common.Windows"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainWindowModel"
    Title="{CompiledBinding Title}"
    BackdropStyle="{CompiledBinding Config.WindowBackdrop}"
    IsFrameless="{CompiledBinding Config.EnableFrameless}"
    ShowTitleBarIcon="{CompiledBinding Config.ShowAppIcon}"
    Background="Transparent">

    <Grid>
        <Border x:Name="PART_WindowSurface" CornerRadius="12" ClipToBounds="True">
            <wv:MainWindowView x:Name="PART_MainView" DataContext="{CompiledBinding .}" />
        </Border>
        <Border x:Name="PART_WindowOutline" CornerRadius="12" BorderBrush="{DynamicResource IgDarkBrush4B505C}"
                BorderThickness="1" IsHitTestVisible="False" ZIndex="1999" />
        <Border x:Name="PART_ResizeHandles" CornerRadius="12" ClipToBounds="True" ZIndex="2000">
            <Grid PointerMoved="ResizeHandle_PointerMoved"
                  PointerReleased="ResizeHandle_PointerReleased"
                  PointerCaptureLost="ResizeHandle_PointerCaptureLost">
                <Border Height="6" Margin="16,0" VerticalAlignment="Top" Background="#02000000" Cursor="SizeNorthSouth" Tag="North" PointerPressed="ResizeHandle_PointerPressed" />
                <Border Height="7" Margin="16,0" VerticalAlignment="Bottom" Background="#02000000" Cursor="SizeNorthSouth" Tag="South" PointerPressed="ResizeHandle_PointerPressed" />
                <Border Width="8" Margin="0,16" HorizontalAlignment="Left" Background="#02000000" Cursor="SizeWestEast" Tag="West" PointerPressed="ResizeHandle_PointerPressed" />
                <Border Width="8" Margin="0,16" HorizontalAlignment="Right" Background="#02000000" Cursor="SizeWestEast" Tag="East" PointerPressed="ResizeHandle_PointerPressed" />
                <Border x:Name="PART_ResizeTopLeft" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#02000000" Cursor="TopLeftCorner" Tag="NorthWest" PointerPressed="ResizeHandle_PointerPressed" />
                <Border x:Name="PART_ResizeTopRight" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#02000000" Cursor="TopRightCorner" Tag="NorthEast" PointerPressed="ResizeHandle_PointerPressed" />
                <Border x:Name="PART_ResizeBottomLeft" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#02000000" Cursor="BottomLeftCorner" Tag="SouthWest" PointerPressed="ResizeHandle_PointerPressed" />
                <Border x:Name="PART_ResizeBottomRight" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#02000000" Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="ResizeHandle_PointerPressed" />
            </Grid>
        </Border>
    </Grid>

</uiw:PhWindow>
