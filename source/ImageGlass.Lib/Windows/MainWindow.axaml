<uiw:PhWindow
    x:Class="ImageGlass.Common.Windows.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cm="using:ImageGlass.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uiw="using:ImageGlass.UI.Windowing"
    xmlns:vm="using:ImageGlass.ViewModels"
    xmlns:wv="using:ImageGlass.Common.Windows"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainWindowModel"
    Cursor="Hand"
    Title="{CompiledBinding Title}"
    BackdropStyle="{CompiledBinding Config.WindowBackdrop}"
    IsFrameless="{CompiledBinding Config.EnableFrameless}"
    ShowTitleBarIcon="{CompiledBinding Config.ShowAppIcon}"
    Background="Transparent">

    <Grid>
        <Border x:Name="PART_WindowSurface" CornerRadius="12" ClipToBounds="True">
            <wv:MainWindowView x:Name="PART_MainView" DataContext="{CompiledBinding .}" />
        </Border>
        <Border x:Name="PART_WindowOutline" CornerRadius="12" BorderBrush="#707070"
                BorderThickness="1" IsHitTestVisible="False" ZIndex="1999" />
        <Grid x:Name="PART_ResizeHandles" ZIndex="2000"
              PointerMoved="ResizeHandle_PointerMoved"
              PointerReleased="ResizeHandle_PointerReleased"
              PointerCaptureLost="ResizeHandle_PointerCaptureLost">
            <Border Height="6" Margin="12,0" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth" Tag="North" PointerPressed="ResizeHandle_PointerPressed" />
            <Border Height="6" Margin="12,0" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" Tag="South" PointerPressed="ResizeHandle_PointerPressed" />
            <Border Width="6" Margin="0,12" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" Tag="West" PointerPressed="ResizeHandle_PointerPressed" />
            <Border Width="6" Margin="0,12" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" Tag="East" PointerPressed="ResizeHandle_PointerPressed" />
            <Border x:Name="PART_ResizeTopLeft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" Tag="NorthWest" PointerPressed="ResizeHandle_PointerPressed" />
            <Border x:Name="PART_ResizeTopRight" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" Tag="NorthEast" PointerPressed="ResizeHandle_PointerPressed" />
            <Border x:Name="PART_ResizeBottomLeft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" Tag="SouthWest" PointerPressed="ResizeHandle_PointerPressed" />
            <Border x:Name="PART_ResizeBottomRight" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="ResizeHandle_PointerPressed" />
        </Grid>
    </Grid>

</uiw:PhWindow>
