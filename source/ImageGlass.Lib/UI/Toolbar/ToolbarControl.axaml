<ui:PhControl
    x:Class="ImageGlass.UI.ToolbarControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:ImageGlass.UI"
    mc:Ignorable="d"
    d:DesignHeight="60"
    d:DesignWidth="800"
    x:DataType="ui:ToolbarControlModel"
    x:Name="Root">

    <ui:PhControl.Styles>
        <Style Selector="Border.toolbar-container">
            <Setter Property="Opacity" Value="0.95" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.toolbar-container:pointerover">
            <Setter Property="Opacity" Value="1.0" />
        </Style>

        <Style Selector="ui|PhToolButton#PART_BtnImageInfo">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.06" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ui|PhToolButton#PART_BtnImageInfo:pointerover">
            <Setter Property="Background" Value="{DynamicResource IG_BackgroundNeutralHoverBrush}" />
        </Style>
        <Style Selector="ui|PhToolButton#PART_BtnImageInfo:pressed">
            <Setter Property="Background" Value="{DynamicResource IG_BackgroundNeutralPressedBrush}" />
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>
    </ui:PhControl.Styles>

    <Border
        x:Name="PART_Root"
        Margin="0,0,8,0"
        Background="{x:Null}">
        <!--  Single Unified Toolbar Container (现代磨砂晶体胶囊)  -->
        <Border
            Classes="toolbar-container"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="8"
            Padding="3,2"
            VerticalAlignment="Center">
            <StackPanel
                x:Name="PART_RootGrid"
                Orientation="Horizontal"
                Spacing="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">

                <!--  Toolbar: Primary Items Island  -->
                <Border
                    x:Name="PART_PrimaryIsland"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
                    <StackPanel
                        x:Name="PART_PrimaryGroup"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2" />
                </Border>

                <!--  Separator Between Primary & Right Groups  -->
                <Border
                    Width="1"
                    Height="16"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource IG_BorderNeutralBrush}"
                    Opacity="0.5" />

                <!--  Toolbar: Right column Island  -->
                <Border
                    x:Name="PART_RightIsland"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    ZIndex="90">
                    <StackPanel
                        x:Name="PART_RightGroup"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">

                        <!--  Image Information Button  -->
                        <ui:PhToolButton
                            x:Name="PART_BtnImageInfo"
                            Click="ImageInfo_Click"
                            ToolTip.Tip="图片信息"
                            Width="30"
                            Height="30"
                            Padding="0"
                            BorderThickness="0"
                            CornerRadius="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Focusable="False">
                            <Panel Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path
                                    Width="14"
                                    Height="14"
                                    Data="{StaticResource IconInfo}"
                                    Fill="#E2E5EB"
                                    Opacity="0.95"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Panel>
                        </ui:PhToolButton>

                    <!--  Toolbar: Overflow button  -->
                    <ui:ToolbarButton
                        x:Name="PART_BtnOverflowMenu"
                        IsVisible="False"
                        Width="30"
                        Height="30"
                        Padding="0"
                        VerticalAlignment="Center"
                        DataContext="{CompiledBinding ButtonOverflowVM}"
                        DropdownOpened="PART_BtnOverflowMenu_DropdownOpened"
                        Focusable="False"
                        IsOpenDropdownMenuOnClick="True">
                        <Border
                            Width="18"
                            Height="18"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                            <Path
                                Data="{StaticResource IconEllipsis}"
                                Fill="#E2E5EB"
                                Opacity="0.95"
                                Stretch="Uniform"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <ui:ToolbarButton.DropdownMenu>
                            <ContextMenu
                                x:Name="PART_OverflowMenu"
                                HorizontalOffset="6"
                                Placement="BottomEdgeAlignedRight" />
                        </ui:ToolbarButton.DropdownMenu>
                    </ui:ToolbarButton>


                    <!--  Toolbar: Secondary Items  -->
                    <StackPanel
                        x:Name="PART_SecondaryGroup"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="2" />


                    <!--  Main Menu button  -->
                    <Panel VerticalAlignment="Center" IsVisible="False">
                        <!--  Update ready badge  -->
                        <Border
                            x:Name="PART_UpdateBadge"
                            Width="8"
                            Height="8"
                            Margin="0,2,2,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource PhAccentFill}"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            IsVisible="False"
                            ZIndex="95" />

                        <ui:ToolbarButton
                            x:Name="PART_BtnMainMenu"
                            DataContext="{CompiledBinding ButtonMenuVM}"
                            DropdownOpened="PART_BtnMainMenu_DropdownOpened"
                            Width="30"
                            Height="30"
                            Padding="0"
                            VerticalAlignment="Center"
                            Focusable="False"
                            IsOpenDropdownMenuOnClick="True">
                        <ui:ToolbarButton.DropdownMenu>
                            <ContextMenu
                                x:Name="PART_MainMenu"
                                HorizontalOffset="6"
                                Placement="BottomEdgeAlignedRight">

                                <!--  Install update (only when a package is ready)  -->
                                <ui:PhMenuItem
                                    x:Name="PART_MnuInstallUpdate"
                                    Classes="attention"
                                    Click="MainMenuItem_Click"
                                    IsVisible="False"
                                    LangKey="Menu_MnuInstallUpdate" />
                                <ui:PhMenuItem
                                    x:Name="PART_MnuInstallUpdateSeparator"
                                    Header="-"
                                    IsVisible="False" />

                                <!--  File  -->
                                <ui:PhMenuItem LangKey="Menu_MnuFile">
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuOpenFile" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuNewWindow" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuSave" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuSaveAs" />
                                    <ui:PhMenuItem
                                        x:Name="PART_MnuExportFrames"
                                        Click="MainMenuItem_Click"
                                        LangKey="Menu_MnuExportFrames" />
                                    <ui:PhMenuItem Header="-" />

                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IsVisible="{OnPlatform False,
                                                               Windows=True,
                                                               x:TypeArguments=x:Boolean}"
                                        LangKey="Menu_MnuOpenWith" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuPrint" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IsVisible="{OnPlatform False,
                                                               Windows=True,
                                                               x:TypeArguments=x:Boolean}"
                                        LangKey="Menu_MnuShare" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuOpenLocation" />
                                    <ui:PhMenuItem Header="-" />

                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuRename" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuMoveToRecycleBin" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuDeleteFromHardDisk" />
                                    <ui:PhMenuItem Header="-" />

                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuImageProperties" />
                                </ui:PhMenuItem>


                                <!--  Navigation  -->
                                <ui:PhMenuItem LangKey="Menu_MnuNavigation">
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuViewNext" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuViewPrevious" />
                                    <ui:PhMenuItem Header="-" />

                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuGoTo" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuGoToFirst" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuGoToLast" />
                                    <ui:PhMenuItem Header="-" />

                                    <ui:PhMenuItem
                                        x:Name="PART_MnuViewNextFrame"
                                        Click="MainMenuItem_Click"
                                        LangKey="Menu_MnuViewNextFrame" />
                                    <ui:PhMenuItem
                                        x:Name="PART_MnuViewPreviousFrame"
                                        Click="MainMenuItem_Click"
                                        LangKey="Menu_MnuViewPreviousFrame" />
                                    <ui:PhMenuItem
                                        x:Name="PART_MnuViewFirstFrame"
                                        Click="MainMenuItem_Click"
                                        LangKey="Menu_MnuViewFirstFrame" />
                                    <ui:PhMenuItem
                                        x:Name="PART_MnuViewLastFrame"
                                        Click="MainMenuItem_Click"
                                        LangKey="Menu_MnuViewLastFrame" />
                                </ui:PhMenuItem>


                                <!--  Zoom  -->
                                <ui:PhMenuItem LangKey="Menu_MnuZoom">
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuZoomIn" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuZoomOut" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuCustomZoom" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuActualSize" />
                                    <ui:PhMenuItem Header="-" />

                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IsChecked="{CompiledBinding IsZoomModeAutoZoom}"
                                        LangKey="Menu_MnuAutoZoom"
                                        ToggleType="CheckBox" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IsChecked="{CompiledBinding IsZoomModeLockZoom}"
                                        LangKey="Menu_MnuLockZoom"
                                        ToggleType="CheckBox" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IsChecked="{CompiledBinding IsZoomModeScaleToWidth}"
                                        LangKey="Menu_MnuScaleToWidth"
                                        ToggleType="CheckBox" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IsChecked="{CompiledBinding IsZoomModeScaleToHeight}"
                                        LangKey="Menu_MnuScaleToHeight"
                                        ToggleType="CheckBox" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IsChecked="{CompiledBinding IsZoomModeScaleToFit}"
                                        LangKey="Menu_MnuScaleToFit"
                                        ToggleType="CheckBox" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IsChecked="{CompiledBinding IsZoomModeScaleToFill}"
                                        LangKey="Menu_MnuScaleToFill"
                                        ToggleType="CheckBox" />
                                </ui:PhMenuItem>


                                <!--  Panning  -->
                                <ui:PhMenuItem LangKey="Menu_MnuPanning">
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuPanLeft" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuPanRight" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuPanUp" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuPanDown" />
                                    <ui:PhMenuItem Header="-" />

                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuPanToLeftSide" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuPanToRightSide" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuPanToTop" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuPanToBottom" />
                                </ui:PhMenuItem>


                                <!--  Image  -->
                                <ui:PhMenuItem LangKey="Menu_MnuImage">
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuRefresh" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuReload" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuReloadImageList" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuUnload" />
                                    <ui:PhMenuItem Header="-" />

                                    <ui:PhMenuItem LangKey="Menu_MnuLoadingOrders">
                                        <ui:PhMenuItem
                                            Click="MainMenuItem_Click"
                                            IsChecked="{CompiledBinding Config.EnableExplorerSortOrder}"
                                            IsVisible="{OnPlatform False,
                                                                   Windows=True,
                                                                   x:TypeArguments=x:Boolean}"
                                            LangKey="Settings_EnableExplorerSortOrder"
                                            ToggleType="CheckBox" />
                                        <ui:PhMenuItem Header="-" IsVisible="{OnPlatform False, Windows=True, x:TypeArguments=x:Boolean}" />

                                        <ui:PhMenuItem
                                            Click="MainMenuItem_Click"
                                            GroupName="ImageOrderBy"
                                            IsChecked="{CompiledBinding IsLoadingByName}"
                                            LangKey="ImageOrderBy_Name"
                                            ToggleType="Radio" />
                                        <ui:PhMenuItem
                                            Click="MainMenuItem_Click"
                                            GroupName="ImageOrderBy"
                                            IsChecked="{CompiledBinding IsLoadingByRandom}"
                                            LangKey="ImageOrderBy_Random"
                                            ToggleType="Radio" />
                                        <ui:PhMenuItem
                                            Click="MainMenuItem_Click"
                                            GroupName="ImageOrderBy"
                                            IsChecked="{CompiledBinding IsLoadingByFileSize}"
                                            LangKey="ImageOrderBy_FileSize"
                                            ToggleType="Radio" />
                                        <ui:PhMenuItem
                                            Click="MainMenuItem_Click"
                                            GroupName="ImageOrderBy"
                                            IsChecked="{CompiledBinding IsLoadingByExtension}"
                                            LangKey="ImageOrderBy_Extension"
                                            ToggleType="Radio" />
                                        <ui:PhMenuItem
                                            Click="MainMenuItem_Click"
                                            GroupName="ImageOrderBy"
                                            IsChecked="{CompiledBinding IsLoadingByDateCreated}"
                                            LangKey="ImageOrderBy_DateCreated"
                                            ToggleType="Radio" />
                                        <ui:PhMenuItem
                                            Click="MainMenuItem_Click"
                                            GroupName="ImageOrderBy"
                                            IsChecked="{CompiledBinding IsLoadingByDateAccessed}"
                                            LangKey="ImageOrderBy_DateAccessed"
                                            ToggleType="Radio" />
                                        <ui:PhMenuItem
                                            Click="MainMenuItem_Click"
                                            GroupName="ImageOrderBy"
                                            IsChecked="{CompiledBinding IsLoadingByDateModified}"
                                            LangKey="ImageOrderBy_DateModified"
                                            ToggleType="Radio" />
                                        <ui:PhMenuItem
                                            Click="MainMenuItem_Click"
                                            GroupName="ImageOrderBy"
                                            IsChecked="{CompiledBinding IsLoadingByExifDateTaken}"
                                            LangKey="ImageOrderBy_ExifDateTaken"
                                            ToggleType="Radio" />
                                        <ui:PhMenuItem
                                            Click="MainMenuItem_Click"
                                            GroupName="ImageOrderBy"
                                            IsChecked="{CompiledBinding IsLoadingByExifRating}"
                                            LangKey="ImageOrderBy_ExifRating"
                                            ToggleType="Radio" />
                                        <ui:PhMenuItem Header="-" />

                                        <ui:PhMenuItem
                                            Click="MainMenuItem_Click"
                                            GroupName="ImageOrderType"
                                            IsChecked="{CompiledBinding IsLoadingAsc}"
                                            LangKey="ImageOrderType_Asc"
                                            ToggleType="Radio" />
                                        <ui:PhMenuItem
                                            Click="MainMenuItem_Click"
                                            GroupName="ImageOrderType"
                                            IsChecked="{CompiledBinding IsLoadingDesc}"
                                            LangKey="ImageOrderType_Desc"
                                            ToggleType="Radio" />
                                    </ui:PhMenuItem>

                                    <ui:PhMenuItem x:Name="PART_MnuViewChannels" LangKey="Menu_MnuViewChannels">
                                        <ui:PhMenuItem
                                            Click="MainMenu_ViewChannelItem_Click"
                                            CommandParameter="R"
                                            Header="R"
                                            IsChecked="{CompiledBinding IsColorChannelR}"
                                            ToggleType="CheckBox" />
                                        <ui:PhMenuItem
                                            Click="MainMenu_ViewChannelItem_Click"
                                            CommandParameter="G"
                                            Header="G"
                                            IsChecked="{CompiledBinding IsColorChannelG}"
                                            ToggleType="CheckBox" />
                                        <ui:PhMenuItem
                                            Click="MainMenu_ViewChannelItem_Click"
                                            CommandParameter="B"
                                            Header="B"
                                            IsChecked="{CompiledBinding IsColorChannelB}"
                                            ToggleType="CheckBox" />
                                        <ui:PhMenuItem
                                            Click="MainMenu_ViewChannelItem_Click"
                                            CommandParameter="A"
                                            Header="A"
                                            IsChecked="{CompiledBinding IsColorChannelA}"
                                            ToggleType="CheckBox" />
                                        <ui:PhMenuItem Header="-" />
                                        <ui:PhMenuItem
                                            Click="MainMenu_ViewChannelItem_Click"
                                            CommandParameter="RGBA"
                                            Header="RGBA" />
                                        <ui:PhMenuItem
                                            Click="MainMenu_ViewChannelItem_Click"
                                            CommandParameter="RGB"
                                            Header="RGB" />
                                        <ui:PhMenuItem
                                            Click="MainMenu_ViewChannelItem_Click"
                                            CommandParameter="RA"
                                            Header="R + A" />
                                        <ui:PhMenuItem
                                            Click="MainMenu_ViewChannelItem_Click"
                                            CommandParameter="GA"
                                            Header="G + A" />
                                        <ui:PhMenuItem
                                            Click="MainMenu_ViewChannelItem_Click"
                                            CommandParameter="BA"
                                            Header="B + A" />
                                        <ui:PhMenuItem
                                            Click="MainMenu_ViewChannelItem_Click"
                                            CommandParameter="A"
                                            Header="A" />
                                    </ui:PhMenuItem>
                                    <ui:PhMenuItem Header="-" />
                                    <ui:PhMenuItem
                                        x:Name="PART_MnuEdit"
                                        Click="MainMenuItem_Click"
                                        LangKey="Menu_MnuEdit" />
                                    <ui:PhMenuItem
                                        x:Name="PART_MnuToggleImageAnimation"
                                        Click="MainMenuItem_Click"
                                        LangKey="Menu_MnuToggleImageAnimation" />
                                    <ui:PhMenuItem
                                        x:Name="PART_MnuInvertColors"
                                        Click="MainMenuItem_Click"
                                        LangKey="Menu_MnuInvertColors" />
                                    <ui:PhMenuItem
                                        x:Name="PART_MnuRotateLeft"
                                        Click="MainMenuItem_Click"
                                        LangKey="Menu_MnuRotateLeft" />
                                    <ui:PhMenuItem
                                        x:Name="PART_MnuRotateRight"
                                        Click="MainMenuItem_Click"
                                        LangKey="Menu_MnuRotateRight" />
                                    <ui:PhMenuItem
                                        x:Name="PART_MnuFlipHorizontal"
                                        Click="MainMenuItem_Click"
                                        LangKey="Menu_MnuFlipHorizontal" />
                                    <ui:PhMenuItem
                                        x:Name="PART_MnuFlipVertical"
                                        Click="MainMenuItem_Click"
                                        LangKey="Menu_MnuFlipVertical" />
                                    <ui:PhMenuItem Header="-" />

                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuSetDesktopBackground" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IsVisible="{OnPlatform False,
                                                               Windows=True,
                                                               x:TypeArguments=x:Boolean}"
                                        LangKey="Menu_MnuSetLockScreen" />
                                </ui:PhMenuItem>


                                <!--  Clipboard  -->
                                <ui:PhMenuItem LangKey="Menu_MnuClipboard">
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuPasteImage" />
                                    <ui:PhMenuItem Header="-" />

                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuCopyImagePixels" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuCopyPath" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuCopyFile" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IsVisible="{OnPlatform True,
                                                               macOS=False,
                                                               x:TypeArguments=x:Boolean}"
                                        LangKey="Menu_MnuCutFile" />
                                    <ui:PhMenuItem Header="-" />

                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuClearClipboard" />
                                </ui:PhMenuItem>


                                <!--  Window modes  -->
                                <ui:PhMenuItem Header="-" />
                                <ui:PhMenuItem
                                    Click="MainMenuItem_Click"
                                    IsChecked="{CompiledBinding Config.EnableWindowFit}"
                                    LangKey="Menu_MnuWindowFit"
                                    ToggleType="CheckBox" />
                                <ui:PhMenuItem
                                    Click="MainMenuItem_Click"
                                    IsChecked="{CompiledBinding Config.EnableFrameless}"
                                    IsVisible="{OnPlatform True,
                                                           Linux=False,
                                                           x:TypeArguments=x:Boolean}"
                                    LangKey="Menu_MnuFrameless"
                                    ToggleType="CheckBox" />
                                <ui:PhMenuItem
                                    Click="MainMenuItem_Click"
                                    IsChecked="{CompiledBinding Config.EnableFullScreen}"
                                    LangKey="Menu_MnuFullScreen"
                                    ToggleType="CheckBox" />
                                <ui:PhMenuItem
                                    Click="MainMenuItem_Click"
                                    IsChecked="{CompiledBinding Config.EnableSlideshow}"
                                    LangKey="Menu_MnuSlideshow"
                                    ToggleType="CheckBox" />
                                <ui:PhMenuItem Header="-" />


                                <!--  Layout  -->
                                <ui:PhMenuItem LangKey="Menu_MnuLayout">
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IsChecked="{CompiledBinding Config.EnableWindowTopMost}"
                                        LangKey="Menu_MnuToggleTopMost"
                                        ToggleType="CheckBox" />
                                    <ui:PhMenuItem Header="-" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IsChecked="{CompiledBinding Config.ShowToolbar}"
                                        LangKey="Menu_MnuToggleToolbar"
                                        ToggleType="CheckBox" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IsChecked="{CompiledBinding Config.ShowGallery}"
                                        LangKey="Menu_MnuToggleGallery"
                                        ToggleType="CheckBox" />
                                    <ui:PhMenuItem Header="-" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuToggleCheckerboard" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuChangeBackgroundColor" />
                                </ui:PhMenuItem>


                                <!--  Tools  -->
                                <ui:PhMenuItem x:Name="PART_MnuTools" LangKey="Menu_MnuTools">
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IconData="{StaticResource IconToolColorPicker}"
                                        LangKey="Menu_MnuColorPicker" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IconData="{StaticResource IconToolCropImage}"
                                        LangKey="Menu_MnuCropTool" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IconData="{StaticResource IconToolFrameNav}"
                                        LangKey="Menu_MnuFrameNav" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IconData="{StaticResource IconToolHdrToneMapper}"
                                        LangKey="Menu_MnuHdrToneMapper" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IconData="{StaticResource IconToolProjector}"
                                        LangKey="Menu_MnuProjector" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IconData="{StaticResource IconToolImageResizer}"
                                        LangKey="Menu_MnuResizeTool" />
                                    <ui:PhMenuItem
                                        Click="MainMenuItem_Click"
                                        IconData="{StaticResource IconToolLosslessCompression}"
                                        LangKey="Menu_MnuLosslessCompression" />
                                    <ui:PhMenuItem x:Name="PART_MnuExternalToolsBeginSeparator" Header="-" />

                                    <ui:PhMenuItem
                                        x:Name="PART_MnuExternalToolsEndSeparator"
                                        Header="-"
                                        IsVisible="False" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuToolsSettings" />
                                </ui:PhMenuItem>
                                <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuPlugins" />


                                <!--  Settings  -->
                                <ui:PhMenuItem Header="-" />
                                <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuSettings" />


                                <!--  Help  -->
                                <ui:PhMenuItem LangKey="Menu_MnuHelp">
                                    <ui:PhMenuItem
                                        x:Name="PART_MnuUpgradeLicense"
                                        Click="MainMenuItem_Click"
                                        LangKey="Menu_MnuUpgradeLicense" />
                                    <ui:PhMenuItem
                                        x:Name="PART_MnuManageLicense"
                                        Click="MainMenuItem_Click"
                                        LangKey="Menu_MnuManageLicense" />

                                    <ui:PhMenuItem Header="-" />

                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="_CheckForUpdate" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuQuickSetup" />
                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuReportIssue" />

                                    <ui:PhMenuItem Header="-" />

                                    <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuAbout" />
                                </ui:PhMenuItem>


                                <!--  Exit  -->
                                <ui:PhMenuItem Header="-" />
                                <ui:PhMenuItem Click="MainMenuItem_Click" LangKey="Menu_MnuExit" />

                            </ContextMenu>
                        </ui:ToolbarButton.DropdownMenu>
                    </ui:ToolbarButton>
                </Panel>

                    <ui:PhToolButton
                        x:Name="PART_BtnSettings"
                        Width="30"
                        Height="30"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Focusable="False"
                        ToolTip.Tip="设置"
                        Click="SettingsButton_Click">
                        <Path Width="14" Height="14" Data="{StaticResource IconSettings}"
                              Fill="#E8E6EB" Stretch="Uniform" />
                    </ui:PhToolButton>

            </StackPanel>
            </Border>

        </StackPanel>
        </Border>
    </Border>

</ui:PhControl>
