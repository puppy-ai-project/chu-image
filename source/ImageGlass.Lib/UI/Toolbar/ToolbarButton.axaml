<ui:PhToolButton
    x:Class="ImageGlass.UI.ToolbarButton"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:ImageGlass.UI"
    mc:Ignorable="d"
    x:DataType="ui:ToolbarItemModel"
    Height="26"
    MinWidth="26"
    Padding="0"
    BorderThickness="0"
    CornerRadius="5.5"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    HorizontalContentAlignment="Center"
    VerticalContentAlignment="Center"
    IsChecked="{CompiledBinding IsChecked}"
    IsVisible="{CompiledBinding IsNotOverflow}"
    ToolTip.Tip="{CompiledBinding Tooltip}">

    <ui:PhToolButton.Styles>
        <Style Selector="ui|ToolbarButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="CornerRadius" Value="5.5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.06" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ui|ToolbarButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush18FFFFFF}" />
        </Style>
        <Style Selector="ui|ToolbarButton:pressed">
            <Setter Property="Background" Value="{DynamicResource IgDarkBrush18FFFFFF}" />
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>
        <Style Selector="ui|ToolbarButton:checked">
            <Setter Property="Background" Value="{DynamicResource IgToolbarCheckedBrush}" />
        </Style>
        <Style Selector="ui|ToolbarButton:disabled">
            <Setter Property="Opacity" Value="0.30" />
        </Style>
    </ui:PhToolButton.Styles>
    <StackPanel
        IsHitTestVisible="False"
        Orientation="Horizontal"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

        <Panel
            x:Name="PART_Icon"
            Width="15.5"
            Height="15.5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Svg
                Width="{Binding #PART_Icon.Width}"
                Height="{Binding #PART_Icon.Height}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.92"
                Path="{CompiledBinding ImagePath}" />

            <!--  placeholder for a button that runs something but has no icon  -->
            <Path
                Width="{Binding #PART_Icon.Width}"
                Height="{Binding #PART_Icon.Height}"
                Data="{StaticResource IconPlaceholder}"
                Fill="{DynamicResource IgDarkBrushE5E7EB}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{CompiledBinding IsPlaceholderIconVisible}"
                Opacity="0.6"
                Stretch="Uniform" />
        </Panel>

        <TextBlock
            x:Name="PART_ButtonText"
            VerticalAlignment="Center"
            Margin="4,0,4,0"
            FontSize="12"
            IsVisible="{CompiledBinding IsTextVisible}"
            Text="{CompiledBinding DisplayText}" />
    </StackPanel>
</ui:PhToolButton>
