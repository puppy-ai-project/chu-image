<ui:PhToolButton
    x:Class="ImageGlass.UI.ToolbarButton"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:ImageGlass.UI"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="ui:ToolbarItemModel"
    Padding="{CompiledBinding ItemPadding}"
    BorderThickness="0"
    CornerRadius="8"
    IsChecked="{CompiledBinding IsChecked}"
    IsVisible="{CompiledBinding IsNotOverflow}"
    ToolTip.Tip="{CompiledBinding Tooltip}">

    <ui:PhToolButton.Styles>
        <Style Selector="ui|ToolbarButton">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.06" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ui|ToolbarButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource IG_ToolButtonBackgroundHover}" />
        </Style>
        <Style Selector="ui|ToolbarButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>
        <Style Selector="ui|ToolbarButton:checked">
            <Setter Property="Background" Value="{DynamicResource IG_ToolButtonBackgroundChecked}" />
        </Style>
    </ui:PhToolButton.Styles>
    <StackPanel
        IsHitTestVisible="False"
        Orientation="Horizontal"
        Spacing="{CompiledBinding InnerSpacing}">

        <Panel
            Width="{CompiledBinding IconSize}"
            Height="{CompiledBinding IconSize}">
            <Svg Path="{CompiledBinding ImagePath}" />

            <!--  placeholder for a button that runs something but has no icon  -->
            <Path
                Data="{StaticResource IconPlaceholder}"
                Fill="{DynamicResource TextControlForeground}"
                IsVisible="{CompiledBinding IsPlaceholderIconVisible}"
                Opacity="0.6"
                Stretch="Uniform" />
        </Panel>

        <TextBlock
            x:Name="PART_ButtonText"
            VerticalAlignment="Center"
            IsVisible="{CompiledBinding IsTextVisible}"
            Text="{CompiledBinding DisplayText}" />
    </StackPanel>
</ui:PhToolButton>
