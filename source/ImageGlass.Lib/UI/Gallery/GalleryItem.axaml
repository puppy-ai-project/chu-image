<ui:PhToolButton
    x:Class="ImageGlass.UI.GalleryItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cm="using:ImageGlass.Common"
    xmlns:photo="using:ImageGlass.Common.Photoing"
    xmlns:ui="using:ImageGlass.UI"
    mc:Ignorable="d"
    d:DesignHeight="200"
    d:DesignWidth="800"
    x:DataType="photo:Photo"
    Padding="3"
    BorderThickness="1"
    CornerRadius="8">

    <ui:PhToolButton.Styles>
        <Style Selector="ui|GalleryItem">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ui|GalleryItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource IG_ToolButtonBackgroundHover}" />
        </Style>
        <Style Selector="ui|GalleryItem:checked">
            <Setter Property="BorderBrush" Value="{DynamicResource PhAccentFill}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{DynamicResource IG_ToolButtonBackgroundChecked}" />
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>
    </ui:PhToolButton.Styles>

    <Grid
        RowDefinitions="*, Auto"
        VerticalAlignment="Stretch"
        IsHitTestVisible="False">

        <!--  Gallery Item: Thumbnail Skeleton  -->
        <Border
            Grid.Row="0"
            Margin="2"
            Background="{DynamicResource IG_BorderNeutralBrush}"
            CornerRadius="{DynamicResource ControlCornerRadius}"
            IsVisible="{CompiledBinding GalleryThumbnail, Converter={x:Static ObjectConverters.IsNull}}">
            <Border.Styles>
                <Style Selector="Border[IsVisible=True]">
                    <Style.Animations>
                        <Animation IterationCount="10" Duration="0:0:1.2">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="0.2" />
                            </KeyFrame>
                            <KeyFrame Cue="50%">
                                <Setter Property="Opacity" Value="1" />
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="0.2" />
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Border.Styles>
        </Border>


        <!--  Gallery Item: Thumbnail Image  -->
        <Border
            Grid.Row="0"
            CornerRadius="5"
            ClipToBounds="True">
            <Image
                RenderOptions.BitmapInterpolationMode="LowQuality"
                Source="{CompiledBinding GalleryThumbnail}"
                Stretch="Uniform" />
        </Border>


        <!--  Gallery Item: File name  -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*, Auto"
            HorizontalAlignment="Center"
            IsVisible="{CompiledBinding ShowGalleryFileName, Source={x:Static cm:Core.Config}}">
            <TextBlock
                Grid.Column="0"
                Padding="2,0,0,0"
                Text="{CompiledBinding GalleryFileTitle}"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                Grid.Column="1"
                Padding="0,0,2,0"
                HorizontalAlignment="Right"
                Text="{CompiledBinding GalleryFileExtension}" />
        </Grid>
    </Grid>
</ui:PhToolButton>
