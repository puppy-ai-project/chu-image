<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?include Variables.wxi ?>

  <!--
    ImageGlass 10 installer, x64, dual scope (per-user or per-machine chosen at install time).
    Built by __assets/win/script-pack-win-msi.ps1, which supplies every $(var.*) below.
  -->
  <Package
      Name="$(var.IgProductName)"
      Manufacturer="$(var.IgManufacturer)"
      Version="$(var.ProductVersion)"
      UpgradeCode="$(var.IgUpgradeCode)"
      ProductCode="$(var.ProductCode)"
      Language="1033"
      Scope="perUserOrMachine"
      InstallerVersion="500"
      Compressed="yes">

    <!-- InstallerVersion 500 is needed twice over: dual-scope packaging and the Hyperlink control. -->
    <!-- IgProductName already carries the version, so do not append it again here. -->
    <SummaryInformation Description="$(var.IgProductName) (x64) Setup"
                        Keywords="Installer,ImageGlass,Photo viewer" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="$(var.Cabinet)" />

    <UIRef Id="IgWixUI" />

    <!-- ==== Upgrades ==================================================================== -->
    <!-- AllowSameVersionUpgrades is required: MSI compares only the first three ProductVersion
         fields, so two builds differing only in the 4th would never upgrade without it. -->
    <MajorUpgrade
        Schedule="afterInstallValidate"
        AllowDowngrades="no"
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="!(loc.IgNewerVersionInstalled)" />

    <!-- IgnoreRemoveFailure is mandatory: a per-user v10 cannot remove a per-machine v9, and
         without it that failure rolls the whole install back. -->
    <Upgrade Id="$(var.Ig9UpgradeCode)">
      <UpgradeVersion
          Minimum="0.0.0"  IncludeMinimum="yes"
          Maximum="10.0.0" IncludeMaximum="no"
          Property="IGV9INSTALLED"
          MigrateFeatures="no"
          OnlyDetect="no"
          IgnoreRemoveFailure="yes" />
    </Upgrade>

    <!-- ==== Public properties (admin-settable on the msiexec command line) =============== -->
    <!-- ALLUSERS=2 and MSIINSTALLPERUSER=1 are emitted automatically by Scope="perUserOrMachine". -->

    <!-- No Value on purpose: this row exists only to put INSTALLFOLDER in SecureCustomProperties. -->
    <Property Id="INSTALLFOLDER" Secure="yes" />

    <Property Id="IGDESKTOPSHORTCUT"   Value="1" Secure="yes" />
    <Property Id="IGSTARTMENUSHORTCUT" Value="1" Secure="yes" />
    <Property Id="IGREMOVEFILEASSOC"   Value="1" Secure="yes" />
    <Property Id="IGAGREETOTERMS"                Secure="yes" />

    <!-- Ticks the "Launch ImageGlass" box on the complete screen; UI only, ignored by /qn. -->
    <Property Id="IGLAUNCHAFTERINSTALL" Value="1" Secure="yes" />

    <!-- ==== UI-internal properties ====================================================== -->
    <Property Id="IGINSTALLSCOPE"   Value="perUser" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- [ProgramFiles64Folder] has already resolved per-user by dialog time, so read the real
         path instead. RegistrySearch is AppSearch, not the Registry table, so ICE105 stays clean. -->
    <Property Id="IGPROGRAMFILES64" Secure="yes">
      <RegistrySearch Id="SearchProgramFiles64" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows\CurrentVersion"
                      Name="ProgramFilesDir" Type="raw" Bitness="always64" />
    </Property>

    <!-- ==== The install being replaced ================================================== -->
    <!-- Windows Installer cannot move a product between per-user and per-machine, so an upgrade
         only succeeds when it runs in the same scope as the install it replaces. -->

    <!-- Scope is whichever hive the HKMU marker landed in. InstallLocation is written below;
         the two shortcut values are the only trace an earlier release left, so they count too. -->
    <Property Id="IGPREVMACHINEDIR" Secure="yes">
      <RegistrySearch Id="PrevMachineDir" Root="HKLM" Key="$(var.IgSetupRegKey)"
                      Name="InstallLocation" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="IGPREVMACHINESM" Secure="yes">
      <RegistrySearch Id="PrevMachineSm" Root="HKLM" Key="$(var.IgSetupRegKey)"
                      Name="StartMenuShortcut" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="IGPREVMACHINEDT" Secure="yes">
      <RegistrySearch Id="PrevMachineDt" Root="HKLM" Key="$(var.IgSetupRegKey)"
                      Name="DesktopShortcut" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="IGPREVUSERDIR" Secure="yes">
      <RegistrySearch Id="PrevUserDir" Root="HKCU" Key="$(var.IgSetupRegKey)"
                      Name="InstallLocation" Type="raw" />
    </Property>
    <Property Id="IGPREVUSERSM" Secure="yes">
      <RegistrySearch Id="PrevUserSm" Root="HKCU" Key="$(var.IgSetupRegKey)"
                      Name="StartMenuShortcut" Type="raw" />
    </Property>
    <Property Id="IGPREVUSERDT" Secure="yes">
      <RegistrySearch Id="PrevUserDt" Root="HKCU" Key="$(var.IgSetupRegKey)"
                      Name="DesktopShortcut" Type="raw" />
    </Property>

    <!-- MSI ignores the fourth version field, so the build number is compared from here instead. -->
    <Property Id="IGPREVMACHINEBUILD" Secure="yes">
      <RegistrySearch Id="PrevMachineBuild" Root="HKLM" Key="$(var.IgSetupRegKey)"
                      Name="InstalledBuild" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="IGPREVUSERBUILD" Secure="yes">
      <RegistrySearch Id="PrevUserBuild" Root="HKCU" Key="$(var.IgSetupRegKey)"
                      Name="InstalledBuild" Type="raw" />
    </Property>

    <!-- An HKLM ARP row is the only proof that 10.0.5.825 was the "All users" install it claimed. -->
    <Property Id="IGBROKENSCOPEARP" Secure="yes">
      <RegistrySearch Id="BrokenScopeArp" Root="HKLM" Type="raw" Bitness="always64"
                      Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{$(var.IgBrokenScopeProductCode)}"
                      Name="DisplayName" />
    </Property>

    <!-- ImageGlass 9 recorded its scope the same way, under its own vendor key. -->
    <Property Id="IGPREV9MACHINE" Secure="yes">
      <RegistrySearch Id="Prev9Machine" Root="HKLM" Key="$(var.Ig9SetupRegKey)"
                      Name="AI_INSTALLPERUSER" Type="raw" Bitness="always64" />
    </Property>

    <!-- Recomputed per sequence rather than carried over from the UI, so a silent install
         resolves alike; chained because two SetProperty rows cannot share an After= anchor. -->
    <SetProperty Id="IGPREVPERMACHINE" Value="1" After="AppSearch" Sequence="both"
                 Condition="IGPREVMACHINEDIR OR IGPREVMACHINESM OR IGPREVMACHINEDT" />
    <SetProperty Id="IGPREVPERUSER" Value="1" After="SetIGPREVPERMACHINE" Sequence="both"
                 Condition="IGPREVUSERDIR OR IGPREVUSERSM OR IGPREVUSERDT" />
    <!-- Paired with FindRelatedProducts so a key left behind by an uninstalled ImageGlass 9
         cannot force an elevated install for nothing. -->
    <SetProperty Id="IGPREV9PERMACHINE" Value="1" After="SetIGPREVPERUSER" Sequence="both"
                 Condition="IGV9INSTALLED AND IGPREV9MACHINE" />
    <!-- Paired with the HKCU marker, so removing that install clears the block with it. -->
    <SetProperty Id="IGBROKENSCOPE" Value="1" After="SetIGPREV9PERMACHINE" Sequence="both"
                 Condition="IGBROKENSCOPEARP AND IGPREVUSERDIR" />
    <!-- Whichever hive the marker landed in; only one of the two is ever present. -->
    <SetProperty Id="IGPREVBUILD" Action="SetIgPrevBuildFromMachine" Value="[IGPREVMACHINEBUILD]"
                 After="SetIGBROKENSCOPE" Sequence="both" Condition="IGPREVMACHINEBUILD" />
    <SetProperty Id="IGPREVBUILD" Action="SetIgPrevBuildFromUser" Value="[IGPREVUSERBUILD]"
                 After="SetIgPrevBuildFromMachine" Sequence="both"
                 Condition="IGPREVUSERBUILD AND NOT IGPREVMACHINEBUILD" />

    <!-- Refused rather than auto-corrected, because a late ALLUSERS flip cannot undo the
         directory redirection already applied. See README, "Upgrading an existing install". -->
    <CustomAction Id="IgBlockPerUserOverMachine" Error="!(loc.IgScopeMismatchMachine)" />
    <CustomAction Id="IgBlockPerMachineOverUser" Error="!(loc.IgScopeMismatchUser)" />
    <!-- Reachable from the wizard too, so unlike those two they are sequenced in both sequences. -->
    <CustomAction Id="IgBlockBrokenScope" Error="!(loc.IgScopeBrokenLegacy)" />
    <!-- MajorUpgrade's own downgrade guard cannot see this: it compares three fields. -->
    <CustomAction Id="IgBlockOlderBuild" Error="!(loc.IgNewerVersionInstalled)" />

    <InstallUISequence>
      <Custom Action="IgBlockOlderBuild" After="SetIgPrevBuildFromUser"
              Condition="NOT Installed AND IGPREVBUILD AND IGPREVBUILD &gt; $(var.BuildNumber)" />
      <Custom Action="IgBlockBrokenScope" After="IgBlockOlderBuild"
              Condition="NOT Installed AND IGBROKENSCOPE" />
      <!-- Behind the scope pre-set: it skips any related product in another context. -->
      <FindRelatedProducts After="SetIgAllUsersFromPrev" />
    </InstallUISequence>

    <!-- Preselect the scope already in use. The dialog locks the choice for a previous
         ImageGlass 10, and leaves it changeable for ImageGlass 9, whose removal is best-effort. -->
    <SetProperty Id="IGINSTALLSCOPE" Value="perMachine" After="IgBlockBrokenScope" Sequence="ui"
                 Condition="IGPREVPERMACHINE OR IGPREV9PERMACHINE" />

    <!-- Matches it, so FindRelatedProducts sees the install being replaced; Next re-publishes it. -->
    <SetProperty Id="ALLUSERS" Action="SetIgAllUsersFromPrev" Value="1" After="SetIGINSTALLSCOPE"
                 Sequence="ui" Condition="IGPREVPERMACHINE OR IGPREV9PERMACHINE" />

    <!-- Not a ComponentSearch: Type="directory" needs a directory key path, and the exe's is a file. -->
    <SetProperty Id="IGPREVDIR" Action="SetIgPrevDirFromMachine" Value="[IGPREVMACHINEDIR]"
                 After="FindRelatedProducts" Sequence="ui" Condition="IGPREVMACHINEDIR" />
    <SetProperty Id="IGPREVDIR" Action="SetIgPrevDirFromUser" Value="[IGPREVUSERDIR]"
                 After="SetIgPrevDirFromMachine" Sequence="ui"
                 Condition="IGPREVUSERDIR AND NOT IGPREVMACHINEDIR" />

    <!-- Both path editors need a non-empty initial value before their dialog is created; the
         previous folder seeds them first, so an upgrade lands on a custom path rather than beside it. -->
    <SetProperty Id="IGFOLDERPERUSER" Action="SetIgFolderPerUserFromPrev" Value="[IGPREVDIR]"
                 After="CostFinalize" Sequence="ui"
                 Condition="IGPREVDIR AND IGPREVPERUSER AND NOT IGPREVPERMACHINE" />
    <SetProperty Id="IGFOLDERPERMACHINE" Action="SetIgFolderPerMachineFromPrev" Value="[IGPREVDIR]"
                 After="SetIgFolderPerUserFromPrev" Sequence="ui"
                 Condition="IGPREVDIR AND IGPREVPERMACHINE" />
    <SetProperty Id="IGFOLDERPERUSER"
                 Value="[LocalAppDataFolder]Programs\$(var.IgFolderName)\"
                 After="SetIgFolderPerMachineFromPrev" Sequence="ui" Condition="NOT IGFOLDERPERUSER" />
    <SetProperty Id="IGFOLDERPERMACHINE"
                 Value="[IGPROGRAMFILES64]\$(var.IgFolderName)\"
                 After="SetIGFOLDERPERUSER" Sequence="ui" Condition="NOT IGFOLDERPERMACHINE" />

    <!-- ==== Add/Remove Programs ========================================================= -->
    <!-- sys.SOURCEFILEDIR, not a bare relative path: wix resolves those against the CWD. -->
    <Icon Id="ImageGlassIcon"
          SourceFile="$(sys.SOURCEFILEDIR)..\..\..\ImageGlass.Win32\icon256.ico" />

    <Property Id="ARPPRODUCTICON"   Value="ImageGlassIcon" />
    <Property Id="ARPCONTACT"       Value="phap@imageglass.org" />
    <Property Id="ARPHELPLINK"      Value="https://imageglass.org/support" />
    <Property Id="ARPURLINFOABOUT"  Value="https://imageglass.org" />
    <Property Id="ARPURLUPDATEINFO" Value="https://imageglass.org/download" />
    <Property Id="ARPCOMMENTS"      Value="A Fast, Seamless Photo Viewer" />

    <!-- One feature only, so Change would be a dead end; Repair still works from a re-run. -->
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- Skip the System Restore point on a ~107 MB install; v9 shipped the same value. -->
    <Property Id="MSIFASTINSTALL" Value="3" />

    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]"
                 After="CostFinalize" Sequence="execute" />

    <!-- ==== Layout ====================================================================== -->
    <!-- MSI resolves this per context at CostFinalize, so silent installs get the right
         default free: %ProgramFiles%\ImageGlass, or %LocalAppData%\Programs\ImageGlass per-user. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.IgFolderName)" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="!(loc.IgFeatureMainTitle)" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="IgAppFiles" />
      <ComponentRef Id="CmpStartMenuShortcut" />
      <ComponentRef Id="CmpDesktopShortcut" />
    </Feature>

    <!-- ==== Uninstall cleanup =========================================================== -->
    <!-- ExeCommand must stay byte-identical to AppCmds.REMOVE_DEFAULT_PHOTO_VIEWER: the app
         matches args[0] case-sensitively, and drift turns this into a GUI launch as SYSTEM. -->
    <!-- Impersonate=no keeps it UAC-free: MSI ignores NoImpersonate when unelevated, so this is
         SYSTEM/HKLM per-machine and the real user/HKCU per-user. -->
    <CustomAction Id="IgRemoveDefaultViewer"
                  FileRef="FileImageGlassExe"
                  ExeCommand="--ig-remove-default-viewer"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Ahead of costing and RemoveExistingProducts, so a refusal changes nothing. NOT ALLUSERS
           is how per-user reads by here, the switching pair having already been collapsed. -->
      <Custom Action="IgBlockOlderBuild" After="SetIgPrevBuildFromUser"
              Condition="NOT Installed AND IGPREVBUILD AND IGPREVBUILD &gt; $(var.BuildNumber)" />
      <Custom Action="IgBlockBrokenScope" After="IgBlockOlderBuild"
              Condition="NOT Installed AND IGBROKENSCOPE" />
      <Custom Action="IgBlockPerUserOverMachine" After="IgBlockBrokenScope"
              Condition="NOT Installed AND IGPREVPERMACHINE AND NOT ALLUSERS" />
      <Custom Action="IgBlockPerMachineOverUser" After="IgBlockPerUserOverMachine"
              Condition="NOT Installed AND IGPREVPERUSER AND NOT IGPREVPERMACHINE AND ALLUSERS" />
      <!-- Before RemoveFiles so the exe still exists. NOT UPGRADINGPRODUCTCODE is critical, or
           every major upgrade would strip the associations via RemoveExistingProducts. -->
      <Custom Action="IgRemoveDefaultViewer" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND IGREMOVEFILEASSOC=&quot;1&quot;" />
    </InstallExecuteSequence>
  </Package>

  <!-- ==== Payload ======================================================================= -->
  <Fragment>
    <ComponentGroup Id="IgAppFiles" Directory="INSTALLFOLDER">
<Component Id="ChuImageAssociations" Guid="C895BBE9-2139-41A0-92C4-103703B5A732">
<RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="ChuImage" Type="string" Value="Software\ChuImage\Capabilities" KeyPath="yes" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities" Name="ApplicationName" Type="string" Value="ChuImage" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities" Name="ApplicationDescription" Type="string" Value="ChuImage image viewer" />
<RegistryValue Root="HKMU" Key="Software\Classes\ChuImage.Image" Name="FriendlyTypeName" Type="string" Value="ChuImage Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\ChuImage.Image\DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]ImageGlass.exe&quot;,0" />
<RegistryValue Root="HKMU" Key="Software\Classes\ChuImage.Image\shell\open" Name="FriendlyAppName" Type="string" Value="ChuImage" />
<RegistryValue Root="HKMU" Key="Software\Classes\ChuImage.Image\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]ImageGlass.exe&quot; &quot;%1&quot;" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".3fr" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.3fr\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".ari" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.ari\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".arw" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.arw\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".avif" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.avif\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".bay" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.bay\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".bmp" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.bmp\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".cap" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.cap\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".cr2" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.cr2\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".cr3" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.cr3\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".crw" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.crw\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".cur" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.cur\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".cut" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.cut\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".dcr" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.dcr\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".dcs" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.dcs\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".dds" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.dds\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".dib" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.dib\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".dng" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.dng\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".drf" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.drf\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".eip" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.eip\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".emf" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.emf\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".erf" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.erf\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".exif" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.exif\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".exr" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.exr\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".fax" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.fax\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".fff" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.fff\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".fits" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.fits\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".flif" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.flif\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".gif" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.gif\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".gifv" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.gifv\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".gpr" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.gpr\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".hdr" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.hdr\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".heic" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.heic\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".heif" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.heif\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".hif" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.hif\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".ico" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.ico\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".iiq" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.iiq\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".jfif" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.jfif\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
<RegistryValue Root="HKMU" Key="Software\ChuImage\Capabilities\FileAssociations" Name=".jp2" Type="string" Value="ChuImage.Image" />
<RegistryValue Root="HKMU" Key="Software\Classes\.jp2\OpenWithProgids" Name="ChuImage.Image" Type="string" Value="" />
